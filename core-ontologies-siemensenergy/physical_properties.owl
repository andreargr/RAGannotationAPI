        <om-2:symbol>lb</om-2:symbol>
        <rdfs:comment xml:lang="en">The apothecaries&apos; pound is a unit of mass defined as 3.732417e-1 kilogram.</rdfs:comment>
        <rdfs:label xml:lang="en">pound (apthecaries&apos;)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/poundAvoirdupois -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/poundAvoirdupois">
