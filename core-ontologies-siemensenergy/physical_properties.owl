        <om-2:symbol>cV</om-2:symbol>
        <rdfs:label xml:lang="en">centivolt</rdfs:label>
        <rdfs:label xml:lang="nl">centivolt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/centiwatt -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/centiwatt">
