        <om-2:symbol>Å2</om-2:symbol>
        <rdfs:label xml:lang="en">square angstrom</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/squareCentimetre -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/squareCentimetre">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/AreaUnit"/>
        <om-2:symbol>cm2</om-2:symbol>
        <rdfs:label xml:lang="en">square centimetre</rdfs:label>
        <rdfs:label xml:lang="nl">vierkante centimeter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/squareKilometre -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/squareKilometre">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/AreaUnit"/>
        <om-2:symbol>km2</om-2:symbol>
        <om-2:unofficialAbbreviation>10^6 m2</om-2:unofficialAbbreviation>
        <rdfs:label xml:lang="en">square kilometre</rdfs:label>
        <rdfs:label xml:lang="nl">vierkante kilometer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetre -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetre">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/AreaUnit"/>
        <om-2:longcomment xml:lang="en">Square metre is a unit of area defined as the area of a square whose sides measure exactly one metre. Square metre is a derived unit in the International System of Units.</om-2:longcomment>
        <om-2:symbol>m2</om-2:symbol>
        <rdfs:comment xml:lang="en">Square metre is a unit of area defined as the area of a square whose sides measure exactly one metre.</rdfs:comment>
        <rdfs:label xml:lang="en">square metre</rdfs:label>
        <rdfs:label xml:lang="nl">vierkante meter</rdfs:label>
        <rdfs:label xml:lang="zh">平方米</rdfs:label>
    </owl:NamedIndividual>
    


