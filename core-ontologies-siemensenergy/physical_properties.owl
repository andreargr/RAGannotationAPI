        <rdfs:label xml:lang="nl">centiwatt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/cubicAngstrom -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/cubicAngstrom">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/VolumeUnit"/>
        <om-2:symbol>Å3</om-2:symbol>
        <rdfs:label xml:lang="en">cubic angstrom</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/cubicCentimetre -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/cubicCentimetre">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/VolumeUnit"/>
        <om-2:symbol>cm3</om-2:symbol>
        <rdfs:label xml:lang="en">cubic centimetre</rdfs:label>
        <rdfs:label xml:lang="nl">kubieke centimeter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/cubicKilometre -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/cubicKilometre">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/VolumeUnit"/>
        <om-2:symbol>km3</om-2:symbol>
        <rdfs:label xml:lang="en">cubic kilometre</rdfs:label>
        <rdfs:label xml:lang="nl">kubieke kilometer</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/cubicMetre -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/cubicMetre">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/VolumeUnit"/>
        <om-2:longcomment xml:lang="en">Cubic metre is a unit of volume defined as the volume of a cube whose sides measure exactly one metre. Cubic metre is a derived unit in the International System of Units.</om-2:longcomment>
        <om-2:symbol>m3</om-2:symbol>
        <rdfs:comment xml:lang="en">Cubic metre is a unit of volume defined as the volume of a cube whose sides measure exactly one metre.</rdfs:comment>
        <rdfs:label xml:lang="en">cubic metre</rdfs:label>
        <rdfs:label xml:lang="nl">kubieke meter</rdfs:label>
    </owl:NamedIndividual>
    


