        <om-2:symbol>ba</om-2:symbol>
        <rdfs:comment xml:lang="en">The barye is a unit of pressure defined as 0.1 pascal.</rdfs:comment>
        <rdfs:label xml:lang="en">barye</rdfs:label>
        <rdfs:label xml:lang="nl">barye</rdfs:label>
    </owl:NamedIndividual>
    


