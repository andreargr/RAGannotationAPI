        <om-2:symbol>bit</om-2:symbol>
        <rdfs:comment xml:lang="en">The bit is a unit of information capacity defined as the information capacity of one binary digit.</rdfs:comment>
        <rdfs:label xml:lang="en">bit</rdfs:label>
        <rdfs:label xml:lang="nl">bit</rdfs:label>
        <rdfs:label xml:lang="zh">指二进制中的一位</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/byte -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/byte">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/InformationCapacityUnit"/>
        <om-2:symbol>B</om-2:symbol>
        <rdfs:comment xml:lang="en">The byte is a unit of information capacity defined as 8 bit.</rdfs:comment>
        <rdfs:label xml:lang="en">byte</rdfs:label>
        <rdfs:label xml:lang="nl">byte</rdfs:label>
        <rdfs:label xml:lang="zh">字节</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/centiampere -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/centiampere">
