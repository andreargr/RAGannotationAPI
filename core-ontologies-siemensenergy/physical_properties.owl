        <om-2:symbol>aW</om-2:symbol>
        <rdfs:label xml:lang="en">attowatt</rdfs:label>
        <rdfs:label xml:lang="nl">attowatt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/bar -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/bar">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/PressureUnit"/>
        <om-2:LaTeXCommand>\barUnit</om-2:LaTeXCommand>
        <om-2:symbol>bar</om-2:symbol>
        <rdfs:comment xml:lang="en">The bar is a unit of pressure defined as 100 000 pascal.</rdfs:comment>
        <rdfs:label xml:lang="en">bar</rdfs:label>
        <rdfs:label xml:lang="nl">bar</rdfs:label>
        <rdfs:label xml:lang="zh">巴（压力计量单位）</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/barye -->

