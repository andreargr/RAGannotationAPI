    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/pascal -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/pascal">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/PressureUnit"/>
        <om-2:longcomment xml:lang="en">The pascal is a unit of pressure and stress defined as newton divided by square metre = joule divided by cubic metre = kilogram divided by metre second squared. The pascal is a derived unit in the International System of Units.</om-2:longcomment>
        <om-2:symbol>Pa</om-2:symbol>
        <rdfs:comment xml:lang="en">The pascal is a unit of pressure and stress defined as newton divided by square metre = joule divided by cubic metre = kilogram divided by metre second squared.</rdfs:comment>
        <rdfs:label xml:lang="en">pascal</rdfs:label>
        <rdfs:label xml:lang="nl">pascal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/petaampere -->

