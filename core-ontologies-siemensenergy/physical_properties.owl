    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/squareMillimetre">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/AreaUnit"/>
        <om-2:symbol>mm2</om-2:symbol>
        <rdfs:label xml:lang="en">square millimetre</rdfs:label>
        <rdfs:label xml:lang="nl">vierkante millimeter</rdfs:label>
    </owl:NamedIndividual>
    


