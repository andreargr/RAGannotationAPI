        <om-2:symbol>cA</om-2:symbol>
        <rdfs:comment xml:lang="en">The centiampere is a unit of electric current defined as 1.0e-2 ampere.</rdfs:comment>
        <rdfs:label xml:lang="en">centiampere</rdfs:label>
        <rdfs:label xml:lang="nl">centiampère</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/centimetre -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/centimetre">
