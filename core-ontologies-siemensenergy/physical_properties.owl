    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/biot">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ElectricCurrentUnit"/>
        <om-2:symbol>Bi</om-2:symbol>
        <rdfs:comment xml:lang="en">The biot is a unit of electric current defined as 10 ampere.</rdfs:comment>
        <rdfs:label xml:lang="en">biot</rdfs:label>
        <rdfs:label xml:lang="nl">biot</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/bit -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/bit">
