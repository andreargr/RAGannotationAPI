        <om-2:symbol>aV</om-2:symbol>
        <rdfs:label xml:lang="en">attovolt</rdfs:label>
        <rdfs:label xml:lang="nl">attovolt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/attowatt -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/attowatt">
