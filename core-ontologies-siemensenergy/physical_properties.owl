        <om-2:alternativeSymbol>oz (av.)</om-2:alternativeSymbol>
        <om-2:alternativeSymbol>oz avdp</om-2:alternativeSymbol>
        <om-2:symbol>oz</om-2:symbol>
        <rdfs:comment xml:lang="en">The avoirdupois ounce is a unit of mass defined as 2.834952e-2 kilogram.</rdfs:comment>
