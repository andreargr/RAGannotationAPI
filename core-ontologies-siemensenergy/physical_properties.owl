    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/abampere -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/abampere">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ElectricCurrentUnit"/>
        <om-2:symbol>abA</om-2:symbol>
        <rdfs:comment xml:lang="en">The abampere is a unit of electric current defined as 10 ampere.</rdfs:comment>
        <rdfs:label xml:lang="en">abampere</rdfs:label>
        <rdfs:label xml:lang="nl">abampère</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/abvolt -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/abvolt">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ElectricPotentialUnit"/>
        <om-2:symbol>abV</om-2:symbol>
        <rdfs:comment xml:lang="en">The abvolt is a unit of electric potential defined as 1.0e-8 volt.</rdfs:comment>
        <rdfs:label xml:lang="en">abvolt</rdfs:label>
        <rdfs:label xml:lang="nl">abvolt</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/ampere -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/ampere">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ElectricCurrentUnit"/>
        <om-2:longcomment xml:lang="en">The ampere is a unit of electric current defined as the constant current that produces an attractive force of 2e–7 newton per metre of length between two straight, parallel conductors of infinite length and negligible circular cross section placed one metre apart in a vacuum. The ampere is a base unit in the International System of Units.</om-2:longcomment>
        <om-2:symbol>A</om-2:symbol>
        <rdfs:comment xml:lang="en">The ampere is a unit of electric current defined as the constant current that produces an attractive force of 2e–7 newton per metre of length between two straight, parallel conductors of infinite length and negligible circular cross section placed one metre apart in a vacuum.</rdfs:comment>
        <rdfs:label xml:lang="en">ampere</rdfs:label>
        <rdfs:label xml:lang="nl">ampère</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/angstrom -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/angstrom">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/LengthUnit"/>
        <om-2:symbol>Å</om-2:symbol>
        <om-2:unofficialLabel xml:lang="nl">angstrom</om-2:unofficialLabel>
        <om-2:unofficialLabel xml:lang="en">ångström</om-2:unofficialLabel>
        <rdfs:comment xml:lang="en">The angstrom is a unit of length defined as 1.0e-10 metre. The unit is often used for wavelengths of electromagnetic radiation or to express the sizes of atoms and molecules.</rdfs:comment>
        <rdfs:label xml:lang="en">angstrom</rdfs:label>
        <rdfs:label xml:lang="nl">ångström</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/atmosphere-Standard -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/atmosphere-Standard">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/PressureUnit"/>
        <om-2:alternativeLabel xml:lang="en">standard atmosphere</om-2:alternativeLabel>
        <om-2:symbol>atm</om-2:symbol>
        <rdfs:comment xml:lang="en">The standard atmosphere is a unit of pressure defined as 1.01325e5 pascal.</rdfs:comment>
        <rdfs:label xml:lang="nl">atmosfeer (standaard)</rdfs:label>
        <rdfs:label xml:lang="en">atmosphere (standard)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/atmosphere-Technical -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/atmosphere-Technical">
        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/PressureUnit"/>
        <om-2:alternativeLabel xml:lang="en">technical atmosphere</om-2:alternativeLabel>
        <om-2:symbol>at</om-2:symbol>
        <rdfs:comment xml:lang="en">The technical atmosphere is a unit of pressure defined as 9.80665e4 pascal.</rdfs:comment>
        <rdfs:label xml:lang="en">atmosphere (technical)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/attoampere -->

