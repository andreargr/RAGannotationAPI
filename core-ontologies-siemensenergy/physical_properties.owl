        <om-2:symbol>aPa</om-2:symbol>
        <rdfs:label xml:lang="en">attopascal</rdfs:label>
        <rdfs:label xml:lang="nl">attopascal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/attovolt -->

    <owl:NamedIndividual rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/attovolt">
