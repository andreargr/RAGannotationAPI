        <rdf:type rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/MassUnit"/>
        <om-2:alternativeLabel xml:lang="en">apothecaries&apos; pound</om-2:alternativeLabel>
        <om-2:alternativeLabel xml:lang="en">pound (troy)</om-2:alternativeLabel>
