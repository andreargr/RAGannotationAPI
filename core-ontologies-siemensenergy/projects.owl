    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/terms/alternative -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/alternative"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#comment">
        <rdfs:comment xml:lang="en"></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->

    <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#label">
        <rdfs:comment xml:lang="en"></rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso">
        <rdfs:comment xml:lang="en"></rdfs:comment>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#category -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#category">
        <rdfs:comment xml:lang="en">Classify prov-o terms into three categories, including &apos;starting-point&apos;, &apos;qualifed&apos;, and &apos;extended&apos;. This classification is used by the prov-o html document to gently introduce prov-o terms to its users. </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/ns/prov#component -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#component">
        <rdfs:comment xml:lang="en">Classify prov-o terms into six components according to prov-dm, including &apos;agents-responsibility&apos;, &apos;alternate&apos;, &apos;annotations&apos;, &apos;collections&apos;, &apos;derivations&apos;, and &apos;entities-activities&apos;. This classification is used so that readers of prov-o specification can find its correspondence with the prov-dm specification.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#constraints -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#constraints">
        <rdfs:comment xml:lang="en">A reference to the principal section of the PROV-CONSTRAINTS document that describes this concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#definition -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#definition">
        <rdfs:comment xml:lang="en">A definition quoted from PROV-DM or PROV-CONSTRAINTS that describes the concept expressed with this OWL term.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#dm -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#dm">
        <rdfs:comment xml:lang="en">A reference to the principal section of the PROV-DM document that describes this concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#editorialNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#editorialNote">
        <rdfs:comment xml:lang="en">A note by the OWL development team about how this term expresses the PROV-DM concept, or how it should be used in context of semantic web or linked data.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/ns/prov#editorsDefinition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#editorsDefinition">
        <rdfs:comment xml:lang="en">When the prov-o term does not have a definition drawn from prov-dm, and the prov-o editor provides one.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/ns/prov#inverse -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#inverse">
        <rdfs:comment xml:lang="en">PROV-O does not define all property inverses. The directionalities defined in PROV-O should be given preference over those not defined. However, if users wish to name the inverse of a PROV-O property, the local name given by prov:inverse should be used.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/TR/prov-o/#names-of-inverse-properties"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/ns/prov#n -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#n">
        <rdfs:comment xml:lang="en">A reference to the principal section of the PROV-DM document that describes this concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#qualifiedForm -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#qualifiedForm">
        <rdfs:comment xml:lang="en">This annotation property links a subproperty of prov:wasInfluencedBy with the subclass of prov:Influence and the qualifying property that are used to qualify it. 

Example annotation:

    prov:wasGeneratedBy prov:qualifiedForm prov:qualifiedGeneration, prov:Generation .

Then this unqualified assertion:

    :entity1 prov:wasGeneratedBy :activity1 .

can be qualified by adding:

   :entity1 prov:qualifiedGeneration :entity1Gen .
   :entity1Gen 
       a prov:Generation, prov:Influence;
       prov:activity :activity1;
       :customValue 1337 .

Note how the value of the unqualified influence (prov:wasGeneratedBy :activity1) is mirrored as the value of the prov:activity (or prov:entity, or prov:agent) property on the influence class.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/ns/prov#sharesDefinitionWith -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#sharesDefinitionWith">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/ns/prov#unqualifiedForm -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#unqualifiedForm">
        <rdfs:comment xml:lang="en">Classes and properties used to qualify relationships are annotated with prov:unqualifiedForm to indicate the property used to assert an unqualified provenance relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://infohub.siemens-energy.com/projects#belongsToProject -->

    <owl:ObjectProperty rdf:about="http://infohub.siemens-energy.com/projects#belongsToProject">
        <rdfs:range rdf:resource="http://linked.data.gov.au/def/project#Project"/>
        <rdfs:label>belongs to project</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://infohub.siemens-energy.com/projects#belongsToSchedule -->

    <owl:ObjectProperty rdf:about="http://infohub.siemens-energy.com/projects#belongsToSchedule">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://infohub.siemens-energy.com/projects#Schedule"/>
        <rdfs:comment>Relationship between an activity and the schedule it belongs to.</rdfs:comment>
        <rdfs:label>belongs to schedule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://infohub.siemens-energy.com/projects#hasActivity -->

    <owl:ObjectProperty rdf:about="http://infohub.siemens-energy.com/projects#hasActivity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://infohub.siemens-energy.com/projects#isActivityOf"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:label>has activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://infohub.siemens-energy.com/projects#hasResponsibleAgent -->

    <owl:ObjectProperty rdf:about="http://infohub.siemens-energy.com/projects#hasResponsibleAgent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:label>has responsible agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://infohub.siemens-energy.com/projects#hasResponsiblePerson -->

    <owl:ObjectProperty rdf:about="http://infohub.siemens-energy.com/projects#hasResponsiblePerson">
        <rdfs:subPropertyOf rdf:resource="http://infohub.siemens-energy.com/projects#hasResponsibleAgent"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:label>has responsible person</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://infohub.siemens-energy.com/projects#hasResponsibleTeam -->

    <owl:ObjectProperty rdf:about="http://infohub.siemens-energy.com/projects#hasResponsibleTeam">
        <rdfs:subPropertyOf rdf:resource="http://infohub.siemens-energy.com/projects#hasResponsibleAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
        <rdfs:label>has responsible team</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://infohub.siemens-energy.com/projects#isActivityOf -->

    <owl:ObjectProperty rdf:about="http://infohub.siemens-energy.com/projects#isActivityOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:label>is activity of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedAssociation -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedAssociation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#qualifiedInfluence"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Association"/>
        <rdfs:comment xml:lang="en">If this Activity prov:wasAssociatedWith Agent :ag, then it can qualify the Association using prov:qualifiedAssociation [ a prov:Association;  prov:agent :ag; :foo :bar ].</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>qualifiedAssociation</rdfs:label>
        <prov:category>qualified</prov:category>
        <prov:component>agents-responsibility</prov:component>
        <prov:inverse>qualifiedAssociationOf</prov:inverse>
        <prov:sharesDefinitionWith rdf:resource="http://www.w3.org/ns/prov#Association"/>
        <prov:unqualifiedForm rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedInfluence -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedInfluence">
        <rdfs:comment xml:lang="en">Because prov:qualifiedInfluence is a broad relation, the more specific relations (qualifiedCommunication, qualifiedDelegation, qualifiedEnd, etc.) should be used when applicable.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>qualifiedInfluence</rdfs:label>
        <prov:category>qualified</prov:category>
        <prov:component>derivations</prov:component>
        <prov:inverse>qualifiedInfluenceOf</prov:inverse>
        <prov:sharesDefinitionWith rdf:resource="http://www.w3.org/ns/prov#Influence"/>
        <prov:unqualifiedForm rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:comment xml:lang="en">An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>wasAssociatedWith</rdfs:label>
        <prov:category>starting-point</prov:category>
        <prov:component>agents-responsibility</prov:component>
        <prov:inverse>wasAssociateFor</prov:inverse>
        <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#Association"/>
        <prov:qualifiedForm rdf:resource="http://www.w3.org/ns/prov#qualifiedAssociation"/>
    </owl:ObjectProperty>
    


    <!-- https://linked.data.gov.au/def/project#hadBudgetTotal -->

    <owl:ObjectProperty rdf:about="https://linked.data.gov.au/def/project#hadBudgetTotal">
        <rdfs:domain rdf:resource="http://linked.data.gov.au/def/project#Project"/>
        <rdfs:range rdf:resource="https://linked.data.gov.au/def/project#SumOfMoney"/>
        <dc:description>Basic funding arrangements are captured through the `proj:hadSponsor` and `proj:hadBudgetTotal` properties.
  
More complex arrangements, for example if multiple funders are involved, can be captured through the `proj:wasFundedThrough` property, which links a funding agent with a funding amount in the context of a project.</dc:description>
        <rdfs:label>total project budget</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://linked.data.gov.au/def/project#hadLeader -->

    <owl:ObjectProperty rdf:about="https://linked.data.gov.au/def/project#hadLeader">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <dc:description>There are a number of distinctive stakeholders in a project, in particular: a leader who is accountable for the delivery of project outcomes; a sponsor under whose authority the project is undertaken; funders; and project staff or participants.
In some cases it is useful to provide specific details of a participant&apos;s role in the project.
PROJECT provides a number of ways to represent the relationships of stakeholders to projects and activities.

The standard role of _leader_ is implemented as a directly named property from an `prov:Activity` to a `prov:Agent`, and _sponsor_ as a directly named property from a `proj:Project` to a `prov:Agent`.

We distinguish one sub-class, the `proj:ResearchProject`, in which the leader(s) is known as a _Principal Investigator_, and which is classified according to its _field of research_.</dc:description>
        <rdfs:label>leader</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://linked.data.gov.au/def/project#hadRelatedActivity -->

    <owl:ObjectProperty rdf:about="https://linked.data.gov.au/def/project#hadRelatedActivity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#qualifiedInfluence"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#ActivityInfluence"/>
    </owl:ObjectProperty>
    


    <!-- https://linked.data.gov.au/def/project#hadSponsor -->

    <owl:ObjectProperty rdf:about="https://linked.data.gov.au/def/project#hadSponsor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <rdfs:domain rdf:resource="http://linked.data.gov.au/def/project#Project"/>
        <dc:description>There are a number of distinctive stakeholders in a project, in particular: a leader who is accountable for the delivery of project outcomes; a sponsor under whose authority the project is undertaken; funders; and project staff or participants.
In some cases it is useful to provide specific details of a participant&apos;s role in the project.
PROJECT provides a number of ways to represent the relationships of stakeholders to projects and activities.

Basic funding arrangements are captured through the `proj:hadSponsor` and `proj:hadBudgetTotal` properties.
More complex arrangements, for example if multiple funders are involved, can be captured through the `proj:wasFundedThrough` property, which links a funding agent with a funding amount in the context of a project.</dc:description>
        <rdfs:label>sponsor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://linked.data.gov.au/def/project#hadSubActivity -->

    <owl:ObjectProperty rdf:about="https://linked.data.gov.au/def/project#hadSubActivity">
        <rdfs:subPropertyOf rdf:resource="http://infohub.siemens-energy.com/projects#hasActivity"/>
        <owl:inverseOf rdf:resource="https://linked.data.gov.au/def/project#wasSubActivityOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <dc:description>Relationship from an activity to a subsidiary activity.</dc:description>
        <rdfs:label>has sub-activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://linked.data.gov.au/def/project#moneyCurrency -->

    <owl:ObjectProperty rdf:about="https://linked.data.gov.au/def/project#moneyCurrency">
        <rdfs:domain rdf:resource="https://linked.data.gov.au/def/project#SumOfMoney"/>
        <rdfs:label>currency of a sum of money</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://linked.data.gov.au/def/project#wasSubActivityOf -->

    <owl:ObjectProperty rdf:about="https://linked.data.gov.au/def/project#wasSubActivityOf">
        <rdfs:subPropertyOf rdf:resource="http://infohub.siemens-energy.com/projects#isActivityOf"/>
        <dc:description>Relationship from an activity to its parent activity or project.</dc:description>
        <rdfs:label>is sub-activity of</rdfs:label>
    </owl:ObjectProperty>
    


