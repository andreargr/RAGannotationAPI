        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/projects#Schedule"/>
        <rdfs:label>baseline schedule</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/projects#CurrentMonthSchedule -->

    <owl:Class rdf:about="http://infohub.siemens-energy.com/projects#CurrentMonthSchedule">
