                                                                   owl:FunctionalProperty ;
                                                          rdfs:domain <http://rds.posccaesar.org/ontology/lis14/rdl/QualityDatum> ;
                                                          rdfs:label "datumValue" ;
                                                          rdfs:seeAlso <http://purl.obolibrary.org/obo/IAO_0000004> ,
                                                                       <http://qudt.org/schema/qudt/numericValue> ,
                                                                       <http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue> ,
                                                                       <http://www.w3.org/ns/ssn/hasSimpleResult> ;
                                                          <http://www.w3.org/2004/02/skos/core#example> "The measured datum \"55 degrees Celsius\" has \"55\" as literal value." ;
                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "If x 'datum value' y, then x is a 'quality datum', and y is the literal value of x." ;
                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The notion of literal value is primitive." ;
                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "A literal value is uninterpreted. Provide a unit of measure, or other category, for a 'quality datum' to be interpretable." ,
                                                                                                                                                    "For numeric non-integer values, the recommended data type is xsd:float." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/datumValue> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/IAO_0000004> ;
   rdfs:comment "BFO-ISO declares no data properties." ,
                "IAO_0000004 is the data property 'has measurement value', in the Information Artefact Ontology."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/datumValue> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://qudt.org/schema/qudt/numericValue> ;
   rdfs:comment "numericValue is a data property in QUDT."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/datumValue> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue> ;
   rdfs:comment "hasNumericalValue is a data property in the Ontology of Units of Measure."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/datumValue> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.w3.org/ns/ssn/hasSimpleResult> ;
   rdfs:comment "hasSimpleResult is a data property in the Semantic Sensor Networks ontology."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/qualityQuantityValue
<http://rds.posccaesar.org/ontology/lis14/rdl/qualityQuantityValue> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:domain <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ;
                                                                    rdfs:label "qualityQuantityValue" ;
                                                                    <http://www.w3.org/2004/02/skos/core#example> "Mass in kilograms, pressure in barg." ;
                                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "If x has 'quality quantity value' y, then x is an 'object', and y is a literal value that quantifies a quality of x." ;
                                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "This relation is \"abstract\" (in the object-orientation sense of the word), a \"hook\": it serves only as a parent for specialised data properties. It serves as a super-property for \"shortcut\" relations that combine a quality, and a unit of measure into a simple data property." ,
                                                                                                                                                              "When introducing shortcut properties as subproperties, annotations should be provided to explain the intended quantity type, any quantification type (e.g., measured, nominal, etc.), and unit of measure." .


###  http://www.demo.org/dtdldemo#freeFloat
<http://www.demo.org/dtdldemo#freeFloat> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <urn:webprotege:ontology:aa91af3b-d944-4c51-a2d6-96b938068fa0#R76oXPJiOdUWLmSU302gppr> ;
                                         rdfs:range xsd:decimal ;
                                         rdfs:label "freeFloat" .


###  http://www.w3.org/2006/time#day
<http://www.w3.org/2006/time#day> rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf <http://rds.posccaesar.org/ontology/lis14/ont/ido-owltime#dateTimeDescriptionValue> ;
                                  rdfs:domain <http://www.w3.org/2006/time#GeneralDateTimeDescription> ;
                                  rdfs:comment """Day position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar day from any calendar. """@en ,
                                               "Posición de día en un sistema calendario-reloj."@es ;
                                  rdfs:label "day"@en ,
                                             "día"@es ;
                                  <http://www.w3.org/2004/02/skos/core#definition> """Day position in a calendar-clock system.

The range of this property is not specified, so can be replaced by any specific representation of a calendar day from any calendar. """@en ,
                                                                                   """Posición de día en un sistema calendario-reloj.

El rango de esta propiedad no está especificado, por tanto, se puede reemplazar por una representación específica de un día de calendario de cualquier calendario."""@es .


###  http://www.w3.org/2006/time#dayOfYear
<http://www.w3.org/2006/time#dayOfYear> rdf:type owl:DatatypeProperty ;
                                        rdfs:subPropertyOf <http://rds.posccaesar.org/ontology/lis14/ont/ido-owltime#dateTimeDescriptionValue> ;
                                        rdfs:domain <http://www.w3.org/2006/time#GeneralDateTimeDescription> ;
                                        rdfs:range xsd:nonNegativeInteger ;
                                        rdfs:comment "El número de día en el año."@es ,
                                                     "The number of the day within the year"@en ;
                                        rdfs:label "day of year"@en ,
                                                   "día del año"@es ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "El número de día en el año."@es ,
                                                                                         "The number of the day within the year"@en .


