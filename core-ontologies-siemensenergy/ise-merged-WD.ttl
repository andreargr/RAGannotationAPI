                                                              rdfs:seeAlso <http://rds.posccaesar.org/ontology/lis14/rdl/hasArrangedPart> ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "For annotations, see the inverse relation 'has arranged part'." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/assembledPartOf
<http://rds.posccaesar.org/ontology/lis14/rdl/assembledPartOf> rdf:type owl:ObjectProperty ;
                                                               rdfs:subPropertyOf <http://rds.posccaesar.org/ontology/lis14/rdl/arrangedPartOf> ;
                                                               owl:inverseOf <http://rds.posccaesar.org/ontology/lis14/rdl/hasAssembledPart> ;
                                                               rdfs:label "assembledPartOf" ;
                                                               rdfs:seeAlso <http://rds.posccaesar.org/ontology/lis14/rdl/hasAssembledPart> ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "For annotations, see the inverse relation 'has assembled part'." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/before
<http://rds.posccaesar.org/ontology/lis14/rdl/before> rdf:type owl:ObjectProperty ;
                                                      owl:equivalentProperty <http://www.w3.org/2006/time#before> ;
                                                      rdfs:subPropertyOf <http://rds.posccaesar.org/ontology/lis14/rdl/occursRelativeTo> ;
                                                      rdfs:label "before" ;
                                                      rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000063> ,
                                                                   <http://rds.posccaesar.org/ontology/lis14/rdl/after> ,
                                                                   "ISO 15926-2:2003 'class_of_temporal_sequence'" ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "The cooling stage takes place before separation." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "If x is 'before' y, then x ends no later than the start of y." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The temporal vocabulary is primitive." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/before> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000063> ;
   rdfs:comment "BFO_0000063 is 'precedes' in BFO-ISO."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/begins
<http://rds.posccaesar.org/ontology/lis14/rdl/begins> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf <http://rds.posccaesar.org/ontology/lis14/rdl/activityBoundOf> ;
                                                      owl:inverseOf <http://rds.posccaesar.org/ontology/lis14/rdl/hasBeginning> ;
