                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "For annotations, see the inverse relation 'has beginning'." .


