                                                     rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000062> ,
                                                                  <http://rds.posccaesar.org/ontology/lis14/rdl/before> ,
                                                                  "ISO 15926-2:2003 'class_of_temporal_sequence'" ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "For annotations, see the inverse relation 'before'." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/after> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000062> ;
   rdfs:comment "BFO_0000062 is 'preceded by' in BFO-ISO."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/arrangedPartOf
<http://rds.posccaesar.org/ontology/lis14/rdl/arrangedPartOf> rdf:type owl:ObjectProperty ;
