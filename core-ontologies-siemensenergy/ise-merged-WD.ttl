#    Classes
#################################################################

###  http://rds.posccaesar.org/ontology/lis14/rdl/Activity
<http://rds.posccaesar.org/ontology/lis14/rdl/Activity> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Temporal> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/hasParticipant> ;
                                                                          owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject>
                                                                        ] ;
                                                        rdfs:label "Activity" ;
                                                        rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000015> ,
                                                                     <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#accomplishment> ,
                                                                     <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#process> ,
                                                                     <http://www.w3.org/ns/prov#Activity> ,
                                                                     "ISO 15926-2:2003 'activity'" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "A pumping, an inspection, a report writing, a fastening (the activity of a bolt in holding two pieces together)." ;
                                                        <http://www.w3.org/2004/02/skos/core#scopeNote> "An 'activity' doesn't need to be temporally connected. For example, intermittent operation of a heater over a week can be represented by a single 'activity' individual; it will occupy a non-connected 'interval region'. The details of each connected activity part (\"singular activities\") may be modelled by relating the activity to 'interval' individuals." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A temporal entity in which one or more physical objects participate." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "(Here we could consider saying the class is in fact not primitive, but defined in terms of 'temporal' and 'has participant'.)" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Activity> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget "ISO 15926-2:2003 'activity'" ;
   rdfs:comment "ISO 15926-2:2003, subclause 4.7.17 states, \"... activities are considered to be space-time extensions in which other individuals and events participate.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/ActivityProfile
<http://rds.posccaesar.org/ontology/lis14/rdl/ActivityProfile> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Activity> ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/profileOfQuality> ;
                                                                                 owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/Quality>
                                                                               ] ;
                                                               rdfs:comment "An 'activity profile' is a part of an 'activity', a \"selective abstraction\" (using a term from the BFO reference guide) made according to a quality of interest to the process. Typically, we will select a physical quantity such as pressure or temperature, and refer to the \"pressure profile\" of the activity. By means of the relation 'profile quantity datum', the activity profile can be related to a set of 'quantity datum' individuals, to which aggregation can be applied, giving a basis for classification." ,
                                                                            "The name \"ActivityProfile\"  has been chosen because lis:Activity corresponds to BFO's 'process'." ;
                                                               rdfs:label "ActivityProfile" ;
                                                               <http://www.w3.org/2004/02/skos/core#example> "An 'activity profile' of an 'activity' involving rotating equipment, instantiating a class \"100 revolutions per minute\"." ,
                                                                                                             "The BFO 2.0 reference guide provides good examples, like \"constant speed profile\", \"acceleration profile\", and \"irregular beat profile\"." ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> <http://purl.obolibrary.org/obo/BFO_0000144> ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An activity obtained by \"selective abstraction\" to just that part of an activity that consists in varying or maintaining a specified 'quality' of a participant." ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of the notion of selective abstraction is beyond the scope of IDO." ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Typically, a physical quantity of a participant, such as a \"pressure\" individual, is selected, and the \"pressure profile\" of the activity is introduced. The relation 'profile of quality' links to that pressure quality individual that defines (is the basis for abstraction to) the activity profile. By means of the relation 'profile quantity datum', the activity profile can be related to 'quantity datum' individuals, to which aggregation can be applied, giving a basis for classification of the activity profile; for example, as a \"rising pressure\" activity." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/ActivityProfile> ;
   owl:annotatedProperty <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000144> ;
   rdfs:comment "BFO_0000144 is 'process profile'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Actual
<http://rds.posccaesar.org/ontology/lis14/rdl/Actual> rdf:type owl:Class ;
                                                      owl:disjointWith <http://rds.posccaesar.org/ontology/lis14/rdl/Specified> ;
                                                      rdfs:label "Actual" ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "A serial-numbered artefact installed at a tag, a function of a concrete artefact, a run or execution of a designed process, an industrial facility \"as built\"." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An entity that is a concrete implementation of a 'specified' entity." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The notion of concrete implementation, of providing an actual item to serve a design, is not defined. An explication should be given in terms of systems engineering practices." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Artefact
<http://rds.posccaesar.org/ontology/lis14/rdl/Artefact> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ;
                                                        rdfs:label "Artefact" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "a pressure transmitter, a process plant, a wrench, a computer." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A 'physical object' that has been created as the result of deliberate activity." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "To give a precise account of \"making\" goes beyond the scope of IDO. An account would engage notions on which there is no clear consensus, including intentional notions of intended purpose, and of goal-directed action; of permanence and integrity; etc. There is an abundance of edge cases for \"artefact\"." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "In IDO, the term 'artefact' is reserved for physical objects, on the consideration that any information object will be a made entity." ,
                                                                                                                                                  "The superclass of 'artefact' is not 'inanimate physical object', in order to allow for artificially made organisms as 'artefact's." ,
                                                                                                                                                  "This is an appropriate superclass \"hook\" for building a hierarchy of industrial item types, including types of equipment, devices, assemblies, buildings, and products." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Capability
<http://rds.posccaesar.org/ontology/lis14/rdl/Capability> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Disposition> ;
                                                          rdfs:comment "The term 'capability' appears as a class in 6 different OBO Foundry ontologies, with identifiers obo:SIO_000112, obo:MF_0000043, and obo:NCIT_C74979." ;
                                                          rdfs:label "Capability" ;
                                                          rdfs:seeAlso <http://purl.obolibrary.org/obo/MF_0000043> ,
                                                                       <http://purl.obolibrary.org/obo/NCIT_C74979> ,
                                                                       <http://purl.obolibrary.org/obo/SIO_000112> ,
                                                                       <http://rds.posccaesar.org/ontology/lis14/rdl/hasCapability> ;
                                                          <http://www.w3.org/2004/02/skos/core#example> "The capability of a motor to generate power, of a pump to generate head and flow. The capability to use a hammer as a paperweight, which is not it's primary capability (function)." ;
                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A disposition which when realized serves a positive or desired outcome." ;
                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Making the notion of \"positive interest\" fully precise is beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Capability> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/MF_0000043> ;
   rdfs:comment "MF_0000043 is 'capability'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Capability> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/NCIT_C74979> ;
   rdfs:comment "NCIT_C74979 is 'capability'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Capability> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/SIO_000112> ;
   rdfs:comment "SIO_000112 is 'capability'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Compound
<http://rds.posccaesar.org/ontology/lis14/rdl/Compound> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/hasQuality> ;
                                                                          owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/MaterialCompositionQuality>
                                                                        ] ;
                                                        rdfs:label "MateriallyClassifiedObject" ;
                                                        rdfs:seeAlso "ISO 15926-2:2003 'class_of_compound'" ;
                                                        <http://www.w3.org/2004/02/skos/core#altLabel> "Compound" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "Individual objects that have composition such as 316 stainless steel, reinforced concrete, carbon monoxide" ;
                                                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Natural kinds are expressly not to be classified as 'compound'. The class 'compound' is only to be used to classify amounts of matter, with non-semantic auxiliaries used to refer to chemical composition. The semantics of natural kinds such as \"helium\", \"steel\", or \"hydrocarbon\" is out of scope for IDO." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A physical object with a defined material composition." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The semantics of materials, of which compounds would be a specialisation, is beyond the scope of IDO." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "For explicit meaning of a 'compound' subclass, such as \"steel [object]\", employ an RDL 'quality' class representing \"material composition\", with restrictions to a modelling construct representing steel." ,
                                                                                                                                                  "Renamed class. Checked materially in OED." ,
                                                                                                                                                  "The class 'compound' serves as an ultimate \"book-keeping\" superclass for a taxonomy of material make-up. It has been found useful in managing classifications (of physical objects) according to material composition. It carries no distinguishing constraints, since any physical object will have material composition. The class 'compound' would perhaps better be named \"physical object classified according to material composition\"." ,
                                                                                                                                                  "This is an abstract concept, or hook, to allow sub-classes to be added as needed." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Dependent
<http://rds.posccaesar.org/ontology/lis14/rdl/Dependent> rdf:type owl:Class ;
                                                         rdfs:comment "The class Dependent is closely related to \"specifically dependent continuant\" in BFO (BFO_0000020)." ,
                                                                      "There is no direct analogue to 'dependent' entities in ISO 15926-2:2003. However, ISO 15926-2:2003 'property' and 'functional_physical_object' largely serve the same purpose as, respectively, 'quality' and 'potential'." ;
                                                         rdfs:label "Dependent" ;
                                                         rdfs:seeAlso <http://rds.posccaesar.org/ontology/lis14/rdl/ActivityProfile> ,
                                                                      "ISO 15926-2:2003 'property', 'functional_physical_object'" ;
                                                         <http://www.w3.org/2004/02/skos/core#altLabel> "Dependent Entity" ;
                                                         <http://www.w3.org/2004/02/skos/core#example> "The colour of a surface, the temperature of a medium, a technical contact role." ,
                                                                                                       "The colour of a surface, the temperature of a medium, the storage-space role of a room." ;
                                                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Any 'object' will be the bearer of various 'dependent' entities, but any 'temporal' entity has only an indirect relationship to 'dependent's. This is in line with BFO, but also a common source of confusion. A common need is to relate a measure based on a 'physical quantity' to an 'activity', like average speed to a transport activity; this may not be implemented as an \"average speed\" dependent entity of the transport. For a suitable representation pattern, see the class 'activity profile' and related resources." ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An entity that is an inherent quality or realizable potential of an object." ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "To provide necessary and sufficient conditions is beyond scope of IDO. Note that the BFO analogue, 'specifically dependent continuant', is defined in terms of the primitive relation 'specifically depends on' (s-depends on), which is not included in IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Dependent> ;
   owl:annotatedProperty <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom> ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000020> ;
   rdfs:comment "BFO_0000020 is 'specifically dependent continuant'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Disposition
<http://rds.posccaesar.org/ontology/lis14/rdl/Disposition> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Potential> ;
                                                           rdfs:comment "An object may not lose a disposition without undergoing physical change." ,
                                                                        "Inspired by the BFO class 'disposition' (BFO_0000016)." ;
                                                           rdfs:label "Disposition" ;
                                                           rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000016> ,
                                                                        <http://rds.posccaesar.org/ontology/lis14/rdl/hasDisposition> ;
                                                           <http://www.w3.org/2004/02/skos/core#example> "The disposition of a steel bar to corrode, the disposition of a gasket to leak. The disposition to overflow a memory buffer." ;
                                                           <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                           <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A potential whose realization is dependent on an object's structure." ;
                                                           <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Making the notion of \"appropriate physical environment\" fully precise is beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Disposition> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000016> ;
   rdfs:comment "BFO_0000016 is 'disposition'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Event
<http://rds.posccaesar.org/ontology/lis14/rdl/Event> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Activity> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/hasTemporalExtent> ;
                                                                       owl:allValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/InstantRegion>
                                                                     ] ;
                                                     rdfs:comment "An 'event' doesn't need to be temporally connected. For example, several instances of switching on a heater over a week may be represented by a single 'event' individual; it will occupy a non-singular 'instant region'. The details of a singular event part may be modelled by relating the event to 'instant' individuals." ,
                                                                  "Event is close in meaning to BFO's 'process boundary', and to DOLCE's 'achievement'. Note that BFO's 'process boundary' is a sibling class to 'process', even though the definition annotation states it to be a \"temporal part of a process\". It's not obvious why the event/process boundary shouldn't have the same participants as the parent activity/process." ;
                                                     rdfs:label "Event" ;
                                                     rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000035> ,
                                                                  <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#achievement> ,
                                                                  "ISO 15926-2:2003 'event'" ;
                                                     <http://www.w3.org/2004/02/skos/core#example> "The beginning of a lifting operation, the end of a measurement activity, the midpoint between beginning and end of an activity." ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An activity  that occurs at one or more specific points in time." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Event> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000035> ;
   rdfs:comment "BFO_0000035 is 'process boundary'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Feature
<http://rds.posccaesar.org/ontology/lis14/rdl/Feature> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ;
                                                       rdfs:label "Feature" ;
                                                       rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000024> ,
                                                                    <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#relevant-part> ,
                                                                    "ISO 15926-2:2003 'class_of_feature'" ;
                                                       <http://www.w3.org/2004/02/skos/core#example> "A flange face, a connection port (terminal), the inside surface of a pump, a painted area of a manifold, a bolt threading." ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A physical object that is a contiguous, non-separable part of a physical object." ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of what \"non-separable\" means is beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Feature> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000024> ;
   <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/explanatoryNote> "BFO_0000024 is 'fiat object part'. This is at least very close in meaning to 'feature' as defined in in ISO 15926."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Function
<http://rds.posccaesar.org/ontology/lis14/rdl/Function> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Capability> ;
                                                        rdfs:comment "Inspired by the BFO class \"function\" (BFO_0000034)." ;
                                                        rdfs:label "Function" ;
                                                        rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000034> ,
                                                                     <http://rds.posccaesar.org/ontology/lis14/rdl/hasFunction> ,
                                                                     "ISO 15926-2:2003 'functional_physical_object'" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "The function of a motor to apply a specified torque to a shaft." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A capability that meets a design requirement." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Making the notion of purpose, or \"existence for being\", fully precise is beyond the scope of IDO." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "The typical 'function' of a hammer is realized when the hammer participates as the tool in a successful nail-driving activity. If the hammer has multiple functions, such as extracting nails using a claw or shaping objects with a ball, each function should be represented with a distinct individual." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Function> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000034> ;
   rdfs:comment "BFO_0000034 is 'function'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/FunctionalObject
<http://rds.posccaesar.org/ontology/lis14/rdl/FunctionalObject> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ,
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/hasFunction> ;
                                                                                  owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/Function>
                                                                                ] ;
                                                                rdfs:label "FunctionalObject" ;
                                                                rdfs:seeAlso "ISO 15926-2:2003 'functional_physical_object'" ;
                                                                <http://www.w3.org/2004/02/skos/core#example> "A pump, a hammer, a password." ;
                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An 'object' that provides a required 'function'." ;
                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/semiFormalNaturalLanguageAxiom> "If x is a 'functional object', then x is an 'object' that 'has function' some 'function'." ;
                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "A \"tag\" (see [[term:tag]]), when included in an IDO asset model, should in general have a type that is subclass of both 'functional object' and 'artefact'." ,
                                                                                                                                                          "A password must be concretized, this is done when it is entered, the password performs the function of unlocking the computer. The password participates in the unlocking process through its concretization." ,
                                                                                                                                                          "Artefact types tend to be described primarily in terms of 'function'; for example, the \"minimal\" definition of a pump would be, \"a physical artefact, the function of which is to pump (to be the active participant in a pumping activity)\". This kind of definition places no restriction on physical make-up and is suitable for a subclass of 'functional object'. Note that the activity type of 'pumping' is here a precursor to the definition of the physical object type 'pump'. A taxonomy of pump classes should extend from a class 'pump' defined solely in terms of function, as above." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/FunctionalObject> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget "ISO 15926-2:2003 'functional_physical_object'" ;
   rdfs:comment "ISO 15926-2:2003, p. 110, states, \"A functional_physical_object is a physical_object that has functional, rather than material, continuity as its basis for identity. Adjacent temporal parts of a functional_physical_object need not have common matter or energy, provided the matter or energy of each temporal part fulfils the same function.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/InanimatePhysicalObject
<http://rds.posccaesar.org/ontology/lis14/rdl/InanimatePhysicalObject> rdf:type owl:Class ;
                                                                       rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ;
                                                                       rdfs:label "InanimatePhysicalObject" ;
                                                                       rdfs:seeAlso "ISO 15926-2:2003 'class_of_inanimate_physical_object'" ;
                                                                       <http://www.w3.org/2004/02/skos/core#example> "A tool, a building, a vehicle, an instrument, a parking lot." ;
                                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A 'physical object' that is not living." ;
                                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "An account of what \"living\" means is beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/InanimatePhysicalObject> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget "ISO 15926-2:2003 'class_of_inanimate_physical_object'" ;
   rdfs:comment "ISO 15926-2:2003, p. 122: \"A class_of_inanimate_physical_object is a class_of_arranged\\-_individual whose members are not living.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject
<http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ;
                                                                 rdfs:label "InformationObject" ;
                                                                 rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000031> ,
                                                                              <http://purl.obolibrary.org/obo/IAO_0000030> ,
                                                                              "ISO 15926-2:2003 'class_of_information_object'" ;
                                                                 <http://www.w3.org/2004/02/skos/core#example> "A report, a drawing, a P&ID diagram, a purchase order, a certificate, a database, a database record, a measurement datum, a unit of measure, an identifier, an algorithm, a programming language." ;
                                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "The BFO class 'generically dependent continuant' represents the notion of a pattern that exists in at least one copy, e.g., \"the sequence of this protein molecule\". This is more general than 'information object', and not at present included in IDO.  'information object' is a subclass, with the added condition that the pattern 'is about' something." ;
                                                                 <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                                 <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An object that captures information about something." ;
                                                                 <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The definition implicitly calls on the BFO notion of generic dependence, as captured in BFO's 'generically dependent continuant', for which IDO doesn't have an analogue." ;
                                                                 <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "A common application of 'information object' is in representing facts about the vocabulary of the ontology itself. The OWL facility of \"punning\" treats OWL classes and properties as OWL individuals, enabling OWL object properties to be applied to them. In use cases that involve punning, the SKOS vocabulary is recommended to be used: the SKOS notions of 'concept', 'concept scheme', and 'collection' should be represented as subclasses of 'information object'." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000031> ;
   rdfs:comment "BFO_0000031 is 'generically dependent continuant'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/IAO_0000030> ;
   rdfs:comment "IAO_0000030 is 'information content entity', a subclass of BFO_0000031 'generically dependent continuant' defined in the Information Artifact Ontology."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Instant
<http://rds.posccaesar.org/ontology/lis14/rdl/Instant> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InstantRegion> ;
                                                       rdfs:label "Instant" ;
                                                       rdfs:seeAlso <http://www.w3.org/2006/time#Instant> ,
                                                                    "ISO 15926-2:2003 'point_in_time'" ;
                                                       <http://www.w3.org/2004/02/skos/core#example> "The moment a valve is closed, the time of a measurement as use for time-stamping, the moment an activity starts." ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An instant region with no proper parts" ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "(Could be considered non-primitive, defined in terms of 'instant region' and 'no proper part'.)" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Instant> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.w3.org/2006/time#Instant> ;
   rdfs:comment "'instant' is defined in OWL Time as \"A temporal entity with zero extent or duration\"."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/InstantRegion
<http://rds.posccaesar.org/ontology/lis14/rdl/InstantRegion> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/TemporalRegion> ;
                                                             rdfs:label "InstantRegion" ;
                                                             rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000148> ;
                                                             <http://www.w3.org/2004/02/skos/core#example> "The moment a valve is closed, the instants of a series of measurements." ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A temporal region whose only parts are one or more points in time." ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "(Could be considered non-primitive, defined in terms of 'temporal region' and each part mapping by 'has temporal extent' to 'instant'.)" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/InstantRegion> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000148> ;
   rdfs:comment "obo:BFO_0000148 is 'zero-dimensional temporal region'"
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Interest
<http://rds.posccaesar.org/ontology/lis14/rdl/Interest> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Potential> ;
                                                        rdfs:label "Interest" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "A plan to act, an approval of a survey." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A potential, the realization of which is of value for the bearer." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Accounting for the notion of (mental) attitude is beyond the scope of IDO." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Interval
<http://rds.posccaesar.org/ontology/lis14/rdl/Interval> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/IntervalRegion> ;
                                                        rdfs:label "Interval" ;
                                                        rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000202> ,
                                                                     <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#time-interval> ,
                                                                     <http://www.w3.org/2006/time#Interval> ,
                                                                     "ISO 15926-2:2003 'period_in_time'" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "The time an instrument has been in operation, the time during which a measurement was made." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A continuous period of time." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of temporal intervals is beyond the scope of IDO (temporal logic offers no obvious consensus)." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Interval> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000202> ;
   rdfs:comment "BFO_0000202 is 'temporal interval'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Interval> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.w3.org/2006/time#Interval> ;
   rdfs:comment "'interval' is defined in OWL Time as \"A temporal entity with an extent or duration\"."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/IntervalRegion
<http://rds.posccaesar.org/ontology/lis14/rdl/IntervalRegion> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/TemporalRegion> ;
                                                              rdfs:label "IntervalRegion" ;
                                                              rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000038> ;
                                                              <http://www.w3.org/2004/02/skos/core#example> "Intermittent times of operation of a heater, maintenance periods at a plant, times that a milling machine is run, The Saturdays of 2011, the construction period for a plant modification" ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A temporal region whose only parts are one or more intervals in time." ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "(This class could be considered non-primitive, defined in terms of 'temporal region' and each part mapping by 'has temporal extent' to 'interval'.)" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/IntervalRegion> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000038> ;
   rdfs:comment "BFO_0000038 is 'one-dimensional temporal region' in BFO-ISO."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/LineInSpace
<http://rds.posccaesar.org/ontology/lis14/rdl/LineInSpace> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation> ;
                                                           rdfs:label "LineInSpace" ;
                                                           <http://www.w3.org/2004/02/skos/core#example> "A line connecting two points with coordinates relative to the frame of reference, the path of a flexible pipe at 12:00 AM." ;
                                                           <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                           <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A spatial location consisting of one or more lines." ;
                                                           <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive account of geometries is beyond the scope of IDO." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Location
<http://rds.posccaesar.org/ontology/lis14/rdl/Location> rdf:type owl:Class ;
                                                        owl:equivalentClass <urn:webprotege:ontology:aa91af3b-d944-4c51-a2d6-96b938068fa0#RDOOMkxXOYR2IymI1vmuZ6c> ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ;
                                                        rdfs:label "Location" ;
                                                        rdfs:seeAlso <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#space-region> ,
                                                                     "ISO 15926-2:2003 'spatial_location'" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "An outdoor plant area, an opening in a wall, the space inside an enclosure" ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An object that is a region in space." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive definition of the notion of location is beyond the scope of IDO." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "IDO is an anthropocentric ontology in the sense that it is disregards complexities of the deep theories of the physical sciences that have only negligible impact at the standard industrial scale. For example, this means ignoring cosmological effects on the average industry and adopting a geocentric model of the universe where there exists a commonly agreed upon stationary earthly “spatial reference system”." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/MaterialCompositionQuality
<http://rds.posccaesar.org/ontology/lis14/rdl/MaterialCompositionQuality> rdf:type owl:Class ;
                                                                          rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
                                                                          rdfs:label "MaterialCompositionQuality" ;
                                                                          <http://www.w3.org/2004/02/skos/core#example> "The steel grade of a cast-iron component, the plastic type of a wire sheathing." ;
                                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A quality that can be characterised in terms of chemical or material properties." ;
                                                                          <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of of \"chemical properties\" is beyond the scope of IDO." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Object
<http://rds.posccaesar.org/ontology/lis14/rdl/Object> rdf:type owl:Class ;
                                                      rdfs:label "Object" ;
                                                      rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000004> ,
                                                                   <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#endurant> ,
                                                                   "ISO 15926-2:2003 'possible_individual'" ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "A process plant, a compressor, a wire, a person, an operator, a database record, an industry standard, a manual document, a site." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An entity that is not dependent on other entities for existence, and which persists through time." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of what counts as an 'object' is beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000004> ;
   rdfs:comment "BFO_0000004 is 'independent continuant'." ;
   <http://www.w3.org/2004/02/skos/core#scopeNote> "In IDO, ’information object’ is represented as a subclass of ’object’. According to the BFO literature, and applied in the Information Artifact Ontology and other BFO compliant ontologies, information artifacts are (multiply) dependent objects. a /sibling/ class to ’independent continuant’ rather than a subclass, as used in IDO."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#endurant> ;
   rdfs:comment "From the DOLCE description of 'endurant': \"The main characteristic of endurants is that all of them are independent essential wholes. ...\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Organism
<http://rds.posccaesar.org/ontology/lis14/rdl/Organism> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ;
                                                        rdfs:label "Organism" ;
                                                        rdfs:seeAlso "ISO 15926-2:2003 'class_of_organism'" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "Animal, plant, fungus, bacterium." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A physical object that is living." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Providing precise semantics of what \"living thing\" amounts to is beyond the scope of IDO." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Organization
<http://rds.posccaesar.org/ontology/lis14/rdl/Organization> rdf:type owl:Class ;
                                                            owl:equivalentClass <urn:webprotege:ontology:aa91af3b-d944-4c51-a2d6-96b938068fa0#R7oyw8YL9q49Oc4hTFGGqSO> ;
                                                            rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ;
                                                            rdfs:label "Organization" ;
                                                            rdfs:seeAlso "ISO 15926-2:2003 'class_of_organization'" ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "A standards body, a service team, a workgroup, a company" ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An object comprising one or more persons who identify by some name and pursue a common set of plans and objectives." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive definition of the notion of organization is beyond the scope of IDO (it would determine which kinds of aggregations of people, and which kinds of roles, are appropriate for organizations)." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Adapted from IOF." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Person
<http://rds.posccaesar.org/ontology/lis14/rdl/Person> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Organism> ;
                                                      rdfs:label "Person" ;
                                                      rdfs:seeAlso "ISO 15926-2:2003 'class_of_person'" ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "A human being." ;
                                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "In industry use cases, subclasses of 'person' will typically require role attributions to be considered fully explicit. For example, 'maintenance engineer' is an obvious subclass of 'person', as every engineer is a person; use a 'role' to say what a maintenance engineer does. I.e., such a class may be augmented with a restriction to say that any member is the bearer of an engineering role; what the role amounts to will then be captured by the kinds of activities that count as realizations of the role." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An organism that is a human." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Providing precise semantics of what \"human\" amounts to is beyond the scope of IDO." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Don't want to use engineer in the example as an engineer is a person with a human role" .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Phase
<http://rds.posccaesar.org/ontology/lis14/rdl/Phase> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/hasQuality> ;
                                                                       owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/PhaseQuality>
                                                                     ] ;
                                                     rdfs:label "Phase" ;
                                                     rdfs:seeAlso "ISO 15926-2:2003 'phase'" ;
                                                     <http://www.w3.org/2004/02/skos/core#example> "A solid object, a liquid object, a gaseous object." ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A physical object with a distinct and homogeneous form." ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The semantics of phases is beyond the scope of IDO." ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Definition from Oxford English Dictionary." ,
                                                                                                                                               "The class 'phase' serves as an ultimate \"book-keeping\" superclass for a taxonomy of phases.  It carries no distinguishing constraints, since any physical object will have phase." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/PhaseQuality
<http://rds.posccaesar.org/ontology/lis14/rdl/PhaseQuality> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
                                                            rdfs:label "PhaseQuality" ;
                                                            owl:deprecated "true"^^xsd:boolean ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "The liquid quality of an amount of molten steel, the solid quality of a steel gasket." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A 'quality' that can be characterised in terms of material phase." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of of \"material phase\" is beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhaseQuality> ;
   owl:annotatedProperty owl:deprecated ;
   owl:annotatedTarget "true"^^xsd:boolean ;
   rdfs:comment "This class is included for coverage of ISO 15926-2:2003, which has 'phase', but many classes don't have a need for it."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject
<http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Object> ;
                                                              rdfs:label "PhysicalObject" ;
                                                              rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000040> ,
                                                                           <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#physical-object> ,
                                                                           "ISO 15926-2:2003 'materialized_physical_object'" ,
                                                                           "ISO 15926-2:2003 'physical_object'" ;
                                                              <http://www.w3.org/2004/02/skos/core#example> "A wall, a fluid stream, a welder, a printed manual, a seafloor." ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An object that occupies space and possesses mass." ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of what it means to be a physical object is beyond the scope of IDO. There is no obvious consensus on the notion of \"material\"." ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Installed software is considered a physical object." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000040> ;
   <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/explanatoryNote> "BFO_0000040 is 'material entity'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget "ISO 15926-2:2003 'physical_object'" ;
   rdfs:comment "IDO asserts that 'physical object' and 'activity' are disjunct classes. In contrast to this, and according to a 4D approach, ISO 15926-2:2003, p. 26, states that \"physical_object and activity are not mutually exclusive. A possible_individual can be both\"."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalQuantity
<http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalQuantity> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
                                                                rdfs:label "PhysicalQuantity" ;
                                                                rdfs:seeAlso <http://purl.obolibrary.org/obo/PATO_0001018> ,
                                                                             <http://qudt.org/schema/qudt/QuantityKind> ,
                                                                             <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#physical-quality> ,
                                                                             <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ,
                                                                             <http://www.w3.org/ns/ssn/ObservableProperty> ,
                                                                             "ISO 15926-2:2003 'property'" ;
                                                                <http://www.w3.org/2004/02/skos/core#example> "The mass of a bar of steel, the temperature of a medium, the inner diameter of a pipe, the lift height of a crane, the head (lift height) of a pump." ;
                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A quality that can be quantified by measurement." ;
                                                                <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The notion of \"unit of measure\" is employed in the definition of 'physical quantity'. It is beyond the scope of IDO to give an account of measurement." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalQuantity> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/PATO_0001018> ;
   rdfs:comment "PATO_0001018 is 'physical quality', defined in the Information Artifact Ontology as \"A quality of a physical entity that exists through action of continuants at the physical level of organisation in relation to other entities.\" Note that this is distinct from 'physical object quality'; see annotation to lis:Quality."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalQuantity> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://qudt.org/schema/qudt/QuantityKind> ;
   rdfs:comment "QUDT explains 'quantity kind' as, \"any observable property that can be measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity.\""
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalQuantity> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#physical-quality> ;
   rdfs:comment "DOLCE defines 'physical-quality' as, \"A quality inherent in a physical endurant.\""
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalQuantity> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
   rdfs:comment "OM2 explains 'quantity' as, \"A quantity is a representation of a quantifiable (standardised) aspect (such as length, mass, and time) of a phenomenon (e.g., a star, a molecule, or a food product). Quantities are classified according to similarity in their (implicit) metrological aspect, e.g. the length of my table and the length of my chair are both classified as length.\""
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalQuantity> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.w3.org/ns/ssn/ObservableProperty> ;
   rdfs:comment "The SSN offers the following as an example for ObservableProperty, a subclass of Property: \"The height of a tree, the depth of a water body, or the temperature of a surface are examples of observable properties, while the value of a classic car is not (directly) observable but asserted.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/PlaneInSpace
<http://rds.posccaesar.org/ontology/lis14/rdl/PlaneInSpace> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation> ;
                                                            rdfs:label "PlaneInSpace" ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "The midway horizontal plane of a volume given by coordinates, the plane of a moving work platform at 12:00" ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A spatial location that is a two-dimensional plane." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive account of geometries is beyond the scope of IDO." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/PointInSpace
<http://rds.posccaesar.org/ontology/lis14/rdl/PointInSpace> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation> ;
                                                            rdfs:label "PointInSpace" ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "The location of a probe at a given point in time" ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A spatial location that has zero dimension with no proper parts." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive account of geometries is beyond the scope of IDO." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Potential
<http://rds.posccaesar.org/ontology/lis14/rdl/Potential> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Dependent> ;
                                                         owl:disjointWith <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
                                                         rdfs:comment "Use OWL property chains to enforce constraints on how the bearer needs to participate in order for an activity to count as a realization." ;
                                                         rdfs:label "Potential" ;
                                                         rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000017> ;
                                                         <http://www.w3.org/2004/02/skos/core#altLabel> "Realizable Entity" ;
                                                         <http://www.w3.org/2004/02/skos/core#example> "The sealing function of a gasket, the disposition of a steel bar to corrode." ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A dependent entity that can potentially be realised through participation in an activity." ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The necessary condition for being a 'potential' is that activity type and participation type are provided. It is however not clear what sufficient conditions would consist in, as these would at least involve a notion of successful execution for the relevant activities, which goes beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Potential> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000017> ;
   rdfs:comment "BFO_0000017 is 'realizable entity'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Quality
<http://rds.posccaesar.org/ontology/lis14/rdl/Quality> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Dependent> ;
                                                       rdfs:comment "DOLCE describes qualities as follows: \"Qualities can be seen as the basic entities we can perceive or measure: shapes, colors, sizes, sounds, smells, as well as weights, lengths, electrical charges... 'Quality' is often used as a synonymous of 'property', but this is not the case in this upper ontology: qualities are particulars, properties are universals.  Qualities inhere to entities: every entity (including qualities themselves) comes with certain qualities, which exist as long as the entity exists.\"" ,
                                                                    "The class Quality and its subclass PhysicalQuantity are inspired by corresponding classes included in the DOLCE and BFO (BFO_0000019) upper ontologies." ;
                                                       rdfs:label "Quality" ;
                                                       rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000019> ,
                                                                    <http://purl.obolibrary.org/obo/PATO_0000001> ,
                                                                    <http://purl.obolibrary.org/obo/PATO_0001241> ,
                                                                    <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#quality> ,
                                                                    <http://www.w3.org/ns/ssn/ActuatableProperty> ,
                                                                    <http://www.w3.org/ns/ssn/Property> ,
                                                                    "ISO 15926-2:2003 'property'" ;
                                                       <http://www.w3.org/2004/02/skos/core#example> "The temperature of a fluid stream, the tensile strength of a bolt, the length of a pipeline, the colour of a surface coating, the familiarity of a specialist with a modification procedure, the quality of a window of being open or closed." ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A dependent entity that is present any time its bearer exists." ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Qualities cover a broad range of what is commonly referred to as \"properties\". It is beyond the scope of IDO to precisely determine what should be included." ;
                                                       <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Qualities are in general subject to change over the lifetime of the bearer. The main IDO device for representing quality changes is through 'datum' individuals: see lis:qualityQuantifiedAs." ,
                                                                                                                                                 "Qualities should only be used for root properties such as voltage, pressure, etc. Where there are variants such as nominal, rated, actual voltage, modellers should use lis:Quality for voltage and use a subclass of lis:QualityDatum for the moderator (\"nominal\", etc.)" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000019> ;
   rdfs:comment "BFO_0000019 is 'quality'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/PATO_0000001> ;
   rdfs:comment "PATO_0000001 is 'quality'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/PATO_0001241> ;
   rdfs:comment "PATO_0001241 is 'physical object quality', defined in the Information Artifact Ontology as \"A quality which inheres in a continuant\"."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.w3.org/ns/ssn/ActuatableProperty> ;
   rdfs:comment "The SSN offers the following as an example for ActuatableProperty, a subclass of Property: \"A window actuator acts by changing the state between a frame and a window. The ability of the window to be opened and closed is its ActuatableProperty.\" Note that IDO doesn't provide an analogue."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.w3.org/ns/ssn/Property> ;
   rdfs:comment "The SSN definition of 'Property' (2017): \"A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity.\""
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget "ISO 15926-2:2003 'property'" ;
   <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/explanatoryNote> "In ISO 15926-2:2003, the term \"quality or characteristic\" is used to explain what the entity type 'property' represents (clause 5.2.26.5, notes 1 and 2). Note 2 reads, \"The types of characteristic or quality, such as temperature or density, are instances of class_of_property.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/QualityDatum
<http://rds.posccaesar.org/ontology/lis14/rdl/QualityDatum> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/quantifiesQuality> ;
                                                                              owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/Quality>
                                                                            ] ;
                                                            rdfs:comment "This class is inspired by the class \"measurement datum\" of the Information Artifact Ontology (IAO). The change of wording from \"measurement\" to \"quality\" is intended to support cases where measurement is not involved, such as with nominal values." ;
                                                            rdfs:label "QualityDatum" ;
                                                            rdfs:seeAlso <http://purl.obolibrary.org/obo/IAO_0000109> ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "10 volts, high (of pressure), low (of temperature), category 3 (as used to rate the strength 'quality' of a storm), 3 MB (a file size), qualifications, grades." ;
                                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Introduce subclasses of 'quality datum' in RDL to distinguish categories of data, such as nominal versus measured values." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An information object that quantifies a quality." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of the notion of representation of magnitudes is beyond scope of IDO." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Quantification may be on nominal, ordinal, and other scales." ,
                                                                                                                                                      "This class may be used for data that don't fit the restriction to \"single unit, single number\" of 'scalar quantity datum', including data employing vectors instead of numbers, and conventional categories like \"high\" and \"medium\"." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/QualityDatum> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/IAO_0000109> ;
   rdfs:comment "IAO_0000109 is 'measurement datum', a class in the Information Artifact Ontology."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Role
<http://rds.posccaesar.org/ontology/lis14/rdl/Role> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Potential> ;
                                                    rdfs:comment "As with any 'potential', the existence of a role is dependent on its bearer. A particular meeting room's role may therefore not be transferred to a different room; a different role individual with similar classification would be needed." ,
                                                                 "This class is intended to serve the same purpose as the ISO 15926-2:2003 'role' entity type, as well as the same-named BFO class (BFO_0000023)." ;
                                                    rdfs:label "Role" ;
                                                    rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000023> ,
                                                                 <http://rds.posccaesar.org/ontology/lis14/rdl/hasRole> ,
                                                                 "ISO 15926-2:2003 'role', 'role_and_domain'" ;
                                                    <http://www.w3.org/2004/02/skos/core#example> "The role an individual person takes in a work situation, such as a manager. A student role." ,
                                                                                                  "The role of an interior space (a 'site') as a meeting room is realized when it serves as the space for conducting meetings. The site may be assigned a storage room role at a different time." ;
                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A potential that is assigned to an object." ;
                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Making the notion of assignment (to a task) fully precise is beyond the scope of IDO. With complex intentions notions of obligation, which are often required in role assignments, this is particularly clear." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Role> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000023> ;
   rdfs:comment "BFO_0000023 is 'role'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/ScalarQuantityDatum
<http://rds.posccaesar.org/ontology/lis14/rdl/ScalarQuantityDatum> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/QualityDatum> ,
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/datumUOM> ;
                                                                                     owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/UnitOfMeasure>
                                                                                   ] ,
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/datumValue> ;
                                                                                     owl:someValuesFrom rdfs:Literal
                                                                                   ] ;
                                                                   rdfs:label "ScalarQuantityDatum" ;
                                                                   rdfs:seeAlso <http://purl.obolibrary.org/obo/IAO_0000032> ,
                                                                                <http://qudt.org/schema/qudt/QuantityValue> ,
                                                                                <http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> ;
                                                                   <http://www.w3.org/2004/02/skos/core#example> "10 kilograms, 220 volt." ;
                                                                   <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "false"^^xsd:boolean ;
                                                                   <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A quality datum that quantifies a physical quantity with a numeric value and a scale." ;
                                                                   <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/semiFormalNaturalLanguageAxiom> "If x is a 'scalar quantity datum', then x is a 'quality datum' which 'quantifies quality' some 'physical quantity', and has a 'datum uom' relationship to a 'unit of measure' and a 'datum value' relationship to a literal value." ;
                                                                   <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "A scalar quantity datum has a unique unit of measure and a unique numeric value. This class is inspired by the class \"scalar measurement datum\" of the Information Artefact Ontology." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/ScalarQuantityDatum> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/IAO_0000032> ;
   rdfs:comment "IAO_0000032 is 'scalar measurement datum', a class in the Information Artifact Ontology."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/ScalarQuantityDatum> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://qudt.org/schema/qudt/QuantityValue> ;
   rdfs:comment "QUDT describes 'quantity value' as follows. \"A Quantity Value expresses the magnitude and kind of a quantity and is given by the product of a numerical value n and a unit of measure U. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit.\""
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/ScalarQuantityDatum> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> ;
   rdfs:comment "OM 2 describes 'measure' as follows. \"A measure combines a number to a unit of measure. For example, '3 m' is a measure.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Scale
<http://rds.posccaesar.org/ontology/lis14/rdl/Scale> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/UnitOfMeasure> ;
                                                     rdfs:label "Scale" ;
                                                     rdfs:seeAlso <http://qudt.org/schema/qudt/Scale> ,
                                                                  <http://www.ontology-of-units-of-measure.org/resource/om-2/Scale> ,
                                                                  "ISO 15926-2:2003 'scale'" ;
                                                     <http://www.w3.org/2004/02/skos/core#example> "centimetre, kilogram per minute, degree Celsius, lunar distance, kilo-lines of code" ;
                                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Arguably, IDO conflates the notions of \"unit of measure\" and \"scale\" in an unhealthy way. While a unit of measure is a definite magnitude, a scale arises from fixing a number range to express multiples of the unit of measure. One may argue that a unit of measure has an implicit scale, obtained by multiplying the unit by any number; this will then allow for undefined or meaningless expressions like \"minus 10 Kelvin\"." ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A unit of measure that, when paired with a number, unambiguously describes the magnitude of a physical quantity." ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive definition of the notion of scale is beyond the scope of IDO." ;
                                                     <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "'scale' corresponds to the common sense notion of unit of measure which unambiguously defines the magnitude of the measure." ,
                                                                                                                                               "The permissible number range for a scale may be expressed in OWL. Semi-formal example: If 'Celsius' is the 'uom of datum' of x, then any 'datum value' of x is within the range of -273,1 to infinity." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Scale> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://qudt.org/schema/qudt/Scale> ;
   rdfs:comment "QUDT provides the following subclasses of 'scale': 'Enumeration scale', 'Interval scale', 'Nominal scale', 'Ordinal scale', 'Ratio scale'. Note that the notion of nominal scales diverges in being a coding scheme, with numbers not implying relative magnitude."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/ShapeQuality
<http://rds.posccaesar.org/ontology/lis14/rdl/ShapeQuality> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Quality> ;
                                                            rdfs:label "ShapeQuality" ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "The flat shape of a surface feature, the cylindrical shape of a piece of pipe." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A quality that can be characterised in terms of geometry." ;
                                                            <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of of \"spatial properties\" is beyond the scope of IDO." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Site
<http://rds.posccaesar.org/ontology/lis14/rdl/Site> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Location> ;
                                                    owl:disjointWith <http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation> ;
                                                    rdfs:comment "This class is inspired by the BFO/Information Artefact Ontology class BFO_0000029 'site'." ;
                                                    rdfs:label "Site" ;
                                                    rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000029> ,
                                                                 "ISO 15926-2:2003 'spatial_location', 'region_in_space'" ;
                                                    <http://www.w3.org/2004/02/skos/core#example> "A flight deck, the inside of a manifold, the hold of a ship, a centre of gravity, an outside area" ;
                                                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Locations such as countries and cities are also considered sites." ,
                                                                                                    "The position of a 'site' follows the position of the 'physical object' by which it is demarcated." ;
                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A location determined in relation to one or more physical objects." ;
                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive definition of the notion of demarcation is beyond the scope of IDO." ;
                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "The utility of a 'site' may be represented by assigning one or more 'role's, such as 'front desk role', 'storage space role', or 'entryway role'." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Site> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000029> ;
   rdfs:comment "BFO_0000029 is 'site'"
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation
<http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Location> ;
                                                               rdfs:label "SpatialLocation" ;
                                                               rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000006> ,
                                                                            "ISO 15926-2:2003 'spatial_location', 'region_in_space'" ;
                                                               <http://www.w3.org/2004/02/skos/core#example> "The cube-shaped region extending 1 metre in each direction from origo, the line extending 10 metres from origo along the z axis, two points with coordinates on a two-dimensional plane; the location of a container at 10:00 AM." ;
                                                               <http://www.w3.org/2004/02/skos/core#scopeNote> "The position of a 'spatial location' is fixed (relative to the frame of reference); it is not dependent on changing positions of 'physical object's." ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A location defined relative to a spatial reference system." ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "To provide an account of space, or spatial reference system, is beyond the scope of IDO." ;
                                                               <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "As with 'spatiotemporal region', a spatial location need not be connected; for example, a location may consist in several cube-shaped regions." ,
                                                                                                                                                         "The extent of a 'spatial location' may be given either in terms of a spatial frame of reference, for instance with coordinates, or by position relative to material entities at a point in time." ,
                                                                                                                                                         "The subclasses 'point in space', 'line in space', 'plane in space', and 'volume in space' are all defined as singular: for example, a 'point in space' individual may not have multiple points as parts. This, in contrast to the analogous BFO classes 'one-dimensional spatial region', etc., which are all defined as plural, allowing for disconnected parts." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000006> ;
   rdfs:comment "BFO_0000006 is 'spatial region'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/SpatiotemporalRegion
<http://rds.posccaesar.org/ontology/lis14/rdl/SpatiotemporalRegion> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Temporal> ;
                                                                    rdfs:comment "An 'activity' occupies a 'spatiotemporal region'. Note that the spatiotemporal region doesn't need to be connected." ;
                                                                    rdfs:label "SpatiotemporalRegion" ;
                                                                    rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000011> ,
                                                                                 <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#spatio-temporal-region> ;
                                                                    <http://www.w3.org/2004/02/skos/core#example> "The spatiotemporal region occupied by the fluid contents of a vessel over a period of time, the spatiotemporal region occupied by a pipeline inspection device (pig) during an inspection." ;
                                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A temporal entity that extends in space and time." ;
                                                                    <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of the notion of spacetime goes beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/SpatiotemporalRegion> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000011> ;
   rdfs:comment "BFO_0000011 is 'spatiotemporal region'."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Specified
<http://rds.posccaesar.org/ontology/lis14/rdl/Specified> rdf:type owl:Class ;
                                                         rdfs:comment "A 'specified' entity is typically an individual that represents the asset as designed, with restrictions that capture requirements." ,
                                                                      "A 'specified' individual may be matched with an individual representing an 'actual' individual. Naming for the according relations may include: 'installed as' for physical objects, and 'executed as' for activities." ;
                                                         rdfs:label "Specified" ;
                                                         rdfs:seeAlso <http://rds.posccaesar.org/ontology/lis14/rdl/Actual> ;
                                                         <http://www.w3.org/2004/02/skos/core#example> "A \"tag\" individual, a function of a tag, an activity as characterised in process design." ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An entity that is part of an engineering specification." ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "The notion of specification is not defined. An explication should be given in terms of systems engineering practices." ;
                                                         <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "This class is not intended to be used directly, but only for serving as the domain of 'implements' and similar relations. The disjointness axiom serves to block iterated chains of 'implements', etc., relationships." .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Stream
<http://rds.posccaesar.org/ontology/lis14/rdl/Stream> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InanimatePhysicalObject> ;
                                                      rdfs:label "Stream" ;
                                                      rdfs:seeAlso "ISO 15926-2:2003 'stream'" ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "A stream of fluid in a pipeline, electricity in an electrical wire, ore moving on a conveyor belt." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An inanimate physical object consisting of energy or homogeneous parts that flow through a system." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A full account of the criteria for what counts as a stream is beyond the scope of IDO." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "The class 'stream' is intended to be used for flows of material or energy, in accordance with conventional use. There is an abundance of cases where use of the term \"stream\" might be called into question, as in, is a stream of electricity really moving; how many cars are needed to participate before it is properly called a \"flow\" of cars; while a flow of sand is a stream, maybe a succession of rolling rocks would not qualify." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Stream> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget "ISO 15926-2:2003 'stream'" ;
   rdfs:comment "ISO 15926-2:2003, p. 112, states, \"A stream is a physical_object that is material or energy moving along a path, where the path is the basis of identity and may be constrained. The stream consists of the temporal parts of those things that are in the stream whilst they are in it.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/System
<http://rds.posccaesar.org/ontology/lis14/rdl/System> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/FunctionalObject> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://rds.posccaesar.org/ontology/lis14/rdl/hasFunctionalPart> ;
                                                                        owl:someValuesFrom <http://rds.posccaesar.org/ontology/lis14/rdl/FunctionalObject>
                                                                      ] ;
                                                      rdfs:label "System" ;
                                                      rdfs:seeAlso <http://rds.posccaesar.org/ontology/lis14/rdl/functionalPartOf> ,
                                                                   <http://www.w3.org/ns/ssn/System> ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "An electrical network, an HVAC system, a pumping system, a compressor." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A 'functional object' with one or more functional parts whose functions contribute to the function of the system." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of the nature of dependency between the function of a system, as a whole, and the functions of its parts is (likely) beyond the scope of IDO." ;
                                                      <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "Most industrial assets are both 'system' and 'inanimate physical object'. When modelling, e.g., a pump system, that system will be an 'inanimate physical object', with the pump part related to the pump system by 'has functional part'. The domain and range restrictions on 'has functional part' then imply that the pump system has type 'system', and the pump has type 'functional object'." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/System> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.w3.org/ns/ssn/System> ;
   rdfs:comment "The SSN definition of 'System' (2017): \"System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other Systems.\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/Temporal
<http://rds.posccaesar.org/ontology/lis14/rdl/Temporal> rdf:type owl:Class ;
                                                        owl:equivalentClass <http://www.w3.org/2006/time#TemporalEntity> ;
                                                        rdfs:comment "In ISO 15926-2:2003, Activity is not a supertype of Event; in BFO, 'process' is not a supertype of 'process boundary'. This may indicate that 'event' in IDO should in fact not be a subclass of 'activity'." ;
                                                        rdfs:label "Temporal" ;
                                                        rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000003> ,
                                                                     <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#perdurant> ;
                                                        <http://www.w3.org/2004/02/skos/core#altLabel> "Temporal Entity" ;
                                                        <http://www.w3.org/2004/02/skos/core#example> "A moment in time, a period of time, an activity or process, a beginning, a closing event." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An entity that is part of time or takes place in time." ;
                                                        <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive account of time, and of the unfolding of events in time, is beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Temporal> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000003> ;
   rdfs:comment "BFO_0000003 is 'occurrent'."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/Temporal> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#perdurant> ;
   rdfs:comment "From the DOLCE description of 'perdurant': \"Perdurants (AKA occurrences) comprise what are variously called events, processes, phenomena, activities and states. ...\""
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/TemporalRegion
<http://rds.posccaesar.org/ontology/lis14/rdl/TemporalRegion> rdf:type owl:Class ;
                                                              rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/Temporal> ;
                                                              rdfs:label "TemporalRegion" ;
                                                              rdfs:seeAlso <http://purl.obolibrary.org/obo/BFO_0000008> ,
                                                                           <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#temporal-region> ;
                                                              <http://www.w3.org/2004/02/skos/core#example> "The moment a valve is closed, upstart time for a motor, the length of time that a bolt has been installed, intervals between maintenance." ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A temporal entity that extends only in time." ;
                                                              <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A precise account of the notion of time goes beyond the scope of IDO." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/TemporalRegion> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/BFO_0000008> ;
   rdfs:comment "BFO_0000008 is 'temporal region'"
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/UnitOfMeasure
<http://rds.posccaesar.org/ontology/lis14/rdl/UnitOfMeasure> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
                                                             rdfs:label "UnitOfMeasure" ;
                                                             rdfs:seeAlso <http://purl.obolibrary.org/obo/UO_0000000> ,
                                                                          <http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> ;
                                                             <http://www.w3.org/2004/02/skos/core#example> "carton, cup, temperature degree, instances of scales" ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "An information object that defines the magnitude of a 'quality', adopted by convention or by law." ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "Precisely determining what qualifies as a unit of measure is beyond the scope of IDO." ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/usageNote> "'unit of measure' may be used when there is ambiguity about the scale of the measure." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/UnitOfMeasure> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/UO_0000000> ;
   rdfs:comment "UO_0000000 is 'unit', a class in the OBO Units of measure ontology."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://rds.posccaesar.org/ontology/lis14/rdl/UnitOfMeasure> ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> ;
   rdfs:comment "'unit' is a class in the Ontology of units of Measure (OM 2)."
 ] .


###  http://rds.posccaesar.org/ontology/lis14/rdl/VolumeInSpace
<http://rds.posccaesar.org/ontology/lis14/rdl/VolumeInSpace> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/SpatialLocation> ;
                                                             rdfs:label "VolumeInSpace" ;
                                                             <http://www.w3.org/2004/02/skos/core#example> "A volume designated for 3D engineering at a point in time, a box-shaped volume determined by coordinates in a 3D frame of reference; the extent of a gas leak at 12:00" ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/isPrimitive> "true"^^xsd:boolean ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition> "A spatial location that is a three-dimensional volume." ;
                                                             <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/primitiveRationale> "A comprehensive account of geometries is beyond the scope of IDO." .


###  http://www.w3.org/2004/02/skos/core#Collection
<http://www.w3.org/2004/02/skos/core#Collection> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
                                                 rdfs:comment "A meaningful collection of concepts." ;
                                                 rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                 rdfs:label "Collection" .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
                                              rdfs:comment "An idea or notion; a unit of thought." ;
                                              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                              rdfs:label "Concept" .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
                                                    rdfs:comment "A set of concepts, optionally including statements about semantic relationships between those concepts." ;
                                                    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                                                    rdfs:label "ConceptScheme" .


###  http://www.w3.org/2006/time#DateTimeDescription
<http://www.w3.org/2006/time#DateTimeDescription> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.w3.org/2006/time#GeneralDateTimeDescription> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#hasTRS> ;
                                                                    owl:hasValue <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#day> ;
                                                                    owl:allValuesFrom xsd:gDay
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#month> ;
                                                                    owl:allValuesFrom xsd:gMonth
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#year> ;
                                                                    owl:allValuesFrom xsd:gYear
                                                                  ] ;
                                                  rdfs:comment "Descripción de fecha y tiempo estructurada con valores separados para los diferentes elementos de un sistema calendario-reloj. El sistema de referencia temporal está fijado al calendario gregoriano, y el rango de las propiedades año, mes, día restringidas a los correspondientes tipos del XML Schema xsd:gYear, xsd:gMonth y xsd:gDay respectivamente."@es ,
                                                               "Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively."@en ;
                                                  rdfs:label "Date-Time description"@en ,
                                                             "descripción de fecha-tiempo"@es ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Descripción de fecha y tiempo estructurada con valores separados para los diferentes elementos de un sistema calendario-reloj. El sistema de referencia temporal está fijado al calendario gregoriano, y el rango de las propiedades año, mes, día restringidas a los correspondientes tipos del XML Schema xsd:gYear, xsd:gMonth y xsd:gDay respectivamente."@es ,
                                                                                                   "Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively."@en .


###  http://www.w3.org/2006/time#DateTimeInterval
<http://www.w3.org/2006/time#DateTimeInterval> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.w3.org/2006/time#ProperInterval> ;
                                               rdfs:comment "'intervalo de fecha-hora' es una subclase de 'intervalo propio', definida utilizando el multi-elemento 'descripción de fecha-hora'."@es ,
                                                            "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en ;
                                               rdfs:label "Date-time interval"@en ,
                                                          "intervalo de fecha-hora"@es ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "'intervalo de fecha-hora' es una subclase de 'intervalo propio', definida utilizando el multi-elemento 'descripción de fecha-hora'."@es ,
                                                                                                "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en ;
                                               <http://www.w3.org/2004/02/skos/core#note> "'intervalo de fecha-hora' se puede utilizar sólo para un intervalo cuyos límites coinciden con un elemento de fecha-hora alineados con el calendario y la zona horaria indicados. Por ejemplo, aunque ambos tienen una duración de un día, el intervalo de 24 horas que empieza en la media noche del comienzo del 8 mayo en Europa Central se puede expresar como un 'intervalo de fecha-hora', el intervalo de 24 horas que empieza a las 1:30pm no."@es ,
                                                                                          ":DateTimeInterval can only be used for an interval whose limits coincide with a date-time element aligned to the calendar and timezone indicated. For example, while both have a duration of one day, the 24-hour interval beginning at midnight at the beginning of 8 May in Central Europe can be expressed as a :DateTimeInterval, but the 24-hour interval starting at 1:30pm cannot."@en .


###  http://www.w3.org/2006/time#DayOfWeek
<http://www.w3.org/2006/time#DayOfWeek> rdf:type owl:Class ;
                                        owl:equivalentClass <urn:webprotege:ontology:aa91af3b-d944-4c51-a2d6-96b938068fa0#RDhUvzGCWw8Dr8cNeU01gTe> ;
                                        rdfs:subClassOf owl:Thing ,
                                                        <http://www.w3.org/2006/time#TemporalPosition> ;
                                        rdfs:comment "El día de la semana"@es ,
                                                     "The day of week"@en ;
                                        rdfs:label "Day of week"@en ,
                                                   "día de la semana"@es ;
                                        <http://www.w3.org/2004/02/skos/core#changeNote> """Remove enumeration from definition, in order to allow other days to be used when required in other calendars. 
NOTE: existing days are still present as members of the class, but the class membership is now open. 

In the original OWL-Time the following constraint appeared: 
  owl:oneOf (
      time:Monday
      time:Tuesday
      time:Wednesday
      time:Thursday
      time:Friday
      time:Saturday
      time:Sunday
    ) ;"""@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "El día de la semana"@es ,
                                                                                         "The day of week"@en ;
                                        <http://www.w3.org/2004/02/skos/core#note> "La pertenencia a la clase 'día de la semana' está abierta, para permitir longitudes de semana alternativas y diferentes nombres de días."@es ,
                                                                                   "Membership of the class :DayOfWeek is open, to allow for alternative week lengths and different day names."@en .


###  http://www.w3.org/2006/time#Duration
<http://www.w3.org/2006/time#Duration> rdf:type owl:Class ;
                                       owl:equivalentClass <urn:webprotege:ontology:aa91af3b-d944-4c51-a2d6-96b938068fa0#RCJqjEDgZm7xubHReqRUzP5> ;
                                       rdfs:subClassOf <http://www.w3.org/2006/time#TemporalDuration> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2006/time#unitType> ;
                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://www.w3.org/2006/time#numericDuration> ;
                                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                                       ] ;
                                       rdfs:comment "Duración de una extensión temporal expresada como un número escalado por una unidad temporal."@es ,
                                                    "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en ;
                                       rdfs:label "Time duration"@en ,
                                                  "duración de tiempo" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "Duración de una extensión temporal expresada como un número escalado por una unidad temporal."@es ,
                                                                                        "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en ;
                                       <http://www.w3.org/2004/02/skos/core#note> "Alternativa a 'descripción de tiempo' para proporcionar descripción soporte a una duración temporal diferente a utilizar un sistema de calendario/reloj."@es ,
                                                                                  "Alternative to time:DurationDescription to support description of a temporal duration other than using a calendar/clock system."@en .


###  http://www.w3.org/2006/time#DurationDescription
<http://www.w3.org/2006/time#DurationDescription> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.w3.org/2006/time#GeneralDurationDescription> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#hasTRS> ;
                                                                    owl:hasValue <http://www.opengis.net/def/uom/ISO-8601/0/Gregorian>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#days> ;
                                                                    owl:allValuesFrom xsd:decimal
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#hours> ;
                                                                    owl:allValuesFrom xsd:decimal
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#minutes> ;
                                                                    owl:allValuesFrom xsd:decimal
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#months> ;
                                                                    owl:allValuesFrom xsd:decimal
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#seconds> ;
                                                                    owl:allValuesFrom xsd:decimal
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#weeks> ;
                                                                    owl:allValuesFrom xsd:decimal
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/2006/time#years> ;
                                                                    owl:allValuesFrom xsd:decimal
                                                                  ] ;
                                                  rdfs:comment "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario. El sistema de referencia temporal se fija al calendario gregoriano, y el intervalo de cada una de las propiedades numéricas se restringe a xsd:decimal."@es ,
                                                               "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en ;
                                                  rdfs:label "Duration description"@en ,
                                                             "descripción de duración"@es ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario. El sistema de referencia temporal se fija al calendario gregoriano, y el intervalo de cada una de las propiedades numéricas se restringe a xsd:decimal."@es ,
                                                                                                   "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#note> "En el calendario gregoriano la longitud de los meses no es fija. Por lo tanto, un valor como \"2,5 meses\" no se puede comparar exactamente con una duración similar expresada en términos de semanas o días."@es ,
                                                                                             "In the Gregorian calendar the length of the month is not fixed. Therefore, a value like \"2.5 months\" cannot be exactly compared with a similar duration expressed in terms of weeks or days."@en .


###  http://www.w3.org/2006/time#GeneralDateTimeDescription
<http://www.w3.org/2006/time#GeneralDateTimeDescription> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.w3.org/2006/time#TemporalPosition> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#unitType> ;
                                                                           owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#dayOfWeek> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#monthOfYear> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#timeZone> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#day> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#dayOfYear> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#hour> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#minute> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#month> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#second> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#week> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#year> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ;
                                                         rdfs:comment "Descripción de fecha y hora estructurada con valores separados para los distintos elementos de un sistema calendario-reloj."@es ,
                                                                      "Description of date and time structured with separate values for the various elements of a calendar-clock system"@en ;
                                                         rdfs:label "Generalized date-time description"@en ,
                                                                    "descripción de fecha-hora generalizada"@es ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "Descripción de fecha y hora estructurada con valores separados para los distintos elementos de un sistema calendario-reloj." ,
                                                                                                          "Description of date and time structured with separate values for the various elements of a calendar-clock system"@en ;
                                                         <http://www.w3.org/2004/02/skos/core#note> "Algunas combinaciones de propiedades son redundantes - por ejemplo, dentro de un 'año' especificado si se proporciona 'día del año' entonces 'día' y 'mes' se pueden computar, y viceversa. Los valores individuales deberían ser consistentes entre ellos y con el calendario, indicado a través del valor de la propiedad 'tiene TRS'."@es ,
                                                                                                    "Some combinations of properties are redundant - for example, within a specified :year if :dayOfYear is provided then :day and :month can be computed, and vice versa. Individual values should be consistent with each other and the calendar, indicated through the value of the :hasTRS property." .


###  http://www.w3.org/2006/time#GeneralDurationDescription
<http://www.w3.org/2006/time#GeneralDurationDescription> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.w3.org/2006/time#TemporalDuration> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#hasTRS> ;
                                                                           owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#days> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#hours> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#minutes> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#months> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#seconds> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#weeks> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.w3.org/2006/time#years> ;
                                                                           owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                         ] ;
                                                         rdfs:comment "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario."@es ,
                                                                      "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en ;
                                                         rdfs:label "Generalized duration description"@en ,
                                                                    "descripción de duración generalizada"@es ;
                                                         <http://www.w3.org/2004/02/skos/core#definition> "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario."@es ,
                                                                                                          "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en ;
                                                         <http://www.w3.org/2004/02/skos/core#note> "La extensión de una duración de tiempo expresada como una 'descripción de duración general' depende del Sistema de Referencia Temporal. En algunos calendarios la longitud de la semana o del mes no es constante a lo largo del año. Por tanto, un valor como \"25 meses\" puede no ser necesariamente ser comparado con un duración similar expresada en términos de semanas o días. Cuando se consideran calendarios que no están basados en el movimiento de la Tierra, se deben tomar incluso más precauciones en la comparación de duraciones."@es ,
                                                                                                    "The extent of a time duration expressed as a GeneralDurationDescription depends on the Temporal Reference System. In some calendars the length of the week or month is not constant within the year. Therefore, a value like \"2.5 months\" may not necessarily be exactly compared with a similar duration expressed in terms of weeks or days. When non-earth-based calendars are considered even more care must be taken in comparing durations."@en .


###  http://www.w3.org/2006/time#Instant
<http://www.w3.org/2006/time#Instant> rdf:type owl:Class ;
                                      owl:equivalentClass <urn:webprotege:ontology:aa91af3b-d944-4c51-a2d6-96b938068fa0#RDCOdK9cTwmotSEn2YyRuOx> ;
                                      rdfs:subClassOf <http://www.w3.org/2006/time#TemporalEntity> ;
                                      owl:disjointWith <http://www.w3.org/2006/time#ProperInterval> ;
                                      rdfs:comment "A temporal entity with zero extent or duration"@en ,
                                                   "Una entidad temporal con una extensión o duración cero."@es ;
                                      rdfs:label "Time instant"@en ,
                                                 "instante de tiempo."@es ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A temporal entity with zero extent or duration"@en ,
                                                                                       "Una entidad temporal con una extensión o duración cero."@es .


###  http://www.w3.org/2006/time#Interval
<http://www.w3.org/2006/time#Interval> rdf:type owl:Class ;
                                       owl:equivalentClass <urn:webprotege:ontology:aa91af3b-d944-4c51-a2d6-96b938068fa0#R8RIOL63OuzKNNLd1trJt0P> ;
                                       rdfs:subClassOf <http://www.w3.org/2006/time#TemporalEntity> ;
                                       rdfs:comment "A temporal entity with an extent or duration"@en ,
                                                    "Una entidad temporal con una extensión o duración."@es ;
                                       rdfs:label "Time interval"@en ,
                                                  "intervalo de tiempo"@es ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A temporal entity with an extent or duration"@en ,
                                                                                        "Una entidad temporal con una extensión o duración."@es .


###  http://www.w3.org/2006/time#January
<http://www.w3.org/2006/time#January> rdf:type owl:Class ;
                                      rdfs:subClassOf <http://www.w3.org/2006/time#DateTimeDescription> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/2006/time#unitType> ;
                                                        owl:hasValue <http://www.w3.org/2006/time#unitMonth>
                                                      ] ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <http://www.w3.org/2006/time#month> ;
                                                        owl:hasValue "--01"
                                                      ] ;
                                      rdfs:label "January" ;
                                      owl:deprecated "true"^^xsd:boolean ;
                                      <http://www.w3.org/2004/02/skos/core#historyNote> "This class was present in the 2006 version of OWL-Time. It was presented as an example of how DateTimeDescription could be specialized, but does not belong in the revised ontology. " .


###  http://www.w3.org/2006/time#MonthOfYear
<http://www.w3.org/2006/time#MonthOfYear> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://www.w3.org/2006/time#DateTimeDescription> ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#unitType> ;
                                                            owl:hasValue <http://www.w3.org/2006/time#unitMonth>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#day> ;
                                                            owl:cardinality "0"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#hour> ;
                                                            owl:cardinality "0"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#minute> ;
                                                            owl:cardinality "0"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#month> ;
                                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#second> ;
                                                            owl:cardinality "0"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#week> ;
                                                            owl:cardinality "0"^^xsd:nonNegativeInteger
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2006/time#year> ;
                                                            owl:cardinality "0"^^xsd:nonNegativeInteger
                                                          ] ;
                                          rdfs:comment "El mes del año."@es ,
                                                       "The month of the year"@en ;
                                          rdfs:label "Month of year"@en ,
                                                     "mes del año"@es ;
                                          <http://www.w3.org/2004/02/skos/core#definition> "El mes del año."@es ,
                                                                                           "The month of the year"@en ;
                                          <http://www.w3.org/2004/02/skos/core#editorialNote> "Característica en riesgo - añadida en la revisión de 2017, y no utilizada todavía de forma amplia."@es ,
                                                                                              "Feature at risk - added in 2017 revision, and not yet widely used. "@en ;
                                          <http://www.w3.org/2004/02/skos/core#note> "La pertenencia a la clase 'mes del año' está abierta, a permitir calendarios anuales alternativos y diferentes nombres de meses."@es ,
                                                                                     "Membership of the class :MonthOfYear is open, to allow for alternative annual calendars and different month names."@en .


###  http://www.w3.org/2006/time#ProperInterval
<http://www.w3.org/2006/time#ProperInterval> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.w3.org/2006/time#Interval> ;
                                             rdfs:comment "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en ,
                                                          "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es ;
                                             rdfs:label "Proper interval"@en ,
                                                        "intervalo propio"@es ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en ,
                                                                                              "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es .


###  http://www.w3.org/2006/time#TRS
<http://www.w3.org/2006/time#TRS> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
                                  rdfs:comment """A temporal reference system, such as a temporal coordinate system (with an origin, direction, and scale), a calendar-clock combination, or a (possibly hierarchical) ordinal system. 

This is a stub class, representing the set of all temporal reference systems."""@en ,
                                               """Un sistema de referencia temporal, tal como un sistema de coordenadas temporales (con un origen, una dirección y una escala), una combinación calendario-reloj, o un sistema ordinal (posiblemente jerárquico).
        Esta clase comodín representa el conjunto de todos los sistemas de referencia temporal."""@es ;
                                  rdfs:label "Temporal Reference System"@en ,
                                             "sistema de referencia temporal"@es ;
                                  <http://www.w3.org/2004/02/skos/core#definition> """A temporal reference system, such as a temporal coordinate system (with an origin, direction, and scale), a calendar-clock combination, or a (possibly hierarchical) ordinal system. 

This is a stub class, representing the set of all temporal reference systems."""@en ,
                                                                                   """Un sistema de referencia temporal, tal como un sistema de coordenadas temporales (con un origen, una dirección y una escala), una combinación calendario-reloj, o un sistema ordinal (posiblemente jerárquico).
    Esta clase comodín representa el conjunto de todos los sistemas de referencia temporal."""@es ;
                                  <http://www.w3.org/2004/02/skos/core#note> "A taxonomy of temporal reference systems is provided in ISO 19108:2002 [ISO19108], including (a) calendar + clock systems; (b) temporal coordinate systems (i.e. numeric offset from an epoch); (c) temporal ordinal reference systems (i.e. ordered sequence of named intervals, not necessarily of equal duration)."@en ,
                                                                             "En el ISO 19108:2002 [ISO19108] se proporciona una taxonomía de sistemas de referencia temporal, incluyendo (a) sistemas de calendario + reloj; (b) sistemas de coordenadas temporales (es decir, desplazamiento numérico a partir de una época); (c) sistemas de referencia ordinales temporales (es decir, secuencia ordenada de intervalos nombrados, no necesariamente de igual duración)."@es .


###  http://www.w3.org/2006/time#TemporalDuration
<http://www.w3.org/2006/time#TemporalDuration> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
                                               rdfs:comment "Extensión de tiempo; duración de un intervalo de tiempo independiente de su posición de inicio particular."@es ,
                                                            "Time extent; duration of a time interval separate from its particular start position"@en ;
                                               rdfs:label "Temporal duration"@en ,
                                                          "duración temporal"@es ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Extensión de tiempo; duración de un intervalo de tiempo independiente de su posición de inicio particular."@es ,
                                                                                                "Time extent; duration of a time interval separate from its particular start position"@en .


###  http://www.w3.org/2006/time#TemporalEntity
<http://www.w3.org/2006/time#TemporalEntity> rdf:type owl:Class ;
                                             owl:equivalentClass [ rdf:type owl:Class ;
                                                                   owl:unionOf ( <http://www.w3.org/2006/time#Instant>
                                                                                 <http://www.w3.org/2006/time#Interval>
                                                                               )
                                                                 ] ;
                                             rdfs:subClassOf owl:Thing ;
                                             rdfs:comment "A temporal interval or instant."@en ,
                                                          "Un intervalo temporal o un instante."@es ;
                                             rdfs:label "Temporal entity"@en ,
                                                        "entidad temporal"@es ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A temporal interval or instant."@en ,
                                                                                              "Un intervalo temporal o un instante."@es .


###  http://www.w3.org/2006/time#TemporalPosition
<http://www.w3.org/2006/time#TemporalPosition> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/2006/time#hasTRS> ;
                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                               ] ;
                                               rdfs:comment "A position on a time-line"@en ,
                                                            "Una posición sobre una línea de tiempo."@es ;
                                               rdfs:label "Temporal position"@en ,
                                                          "posición temporal"@es ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "A position on a time-line"@en ,
                                                                                                "Una posición sobre una línea de tiempo."@es .


###  http://www.w3.org/2006/time#TemporalUnit
<http://www.w3.org/2006/time#TemporalUnit> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.w3.org/2006/time#TemporalDuration> ;
                                           rdfs:comment "A standard duration, which provides a scale factor for a time extent, or the granularity or precision for a time position."@en ,
                                                        "Una duración estándar, que proporciona un factor de escala para una extensión de tiempo, o la granularidad o precisión para una posición de tiempo."@es ;
                                           rdfs:label "Temporal unit"@en ,
                                                      "unidad de tiempo"@es ;
                                           <http://www.w3.org/2004/02/skos/core#changeNote> """Remove enumeration from definition, in order to allow other units to be used when required in other coordinate systems. 
NOTE: existing units are still present as members of the class, but the class membership is now open. 

In the original OWL-Time the following constraint appeared: 
  owl:oneOf (
      time:unitSecond
      time:unitMinute
      time:unitHour
      time:unitDay
      time:unitWeek
      time:unitMonth
      time:unitYear
    ) ;"""@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A standard duration, which provides a scale factor for a time extent, or the granularity or precision for a time position."@en ,
                                                                                            "Una duración estándar, que proporciona un factor de escala para una extensión de tiempo, o la granularidad o precisión para una posición de tiempo."@es ;
                                           <http://www.w3.org/2004/02/skos/core#note> "La pertenencia de la clase 'unidad de tiempo' está abierta, para permitir otras unidades de tiempo utilizadas en algunas aplicaciones técnicas (por ejemplo, millones de años o el mes Baha'i)."@es ,
                                                                                      "Membership of the class TemporalUnit is open, to allow for other temporal units used in some technical applications (e.g. millions of years, Baha'i month)."@en .


###  http://www.w3.org/2006/time#TimePosition
<http://www.w3.org/2006/time#TimePosition> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.w3.org/2006/time#TemporalPosition> ,
                                                           [ rdf:type owl:Class ;
                                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://www.w3.org/2006/time#nominalPosition> ;
                                                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://www.w3.org/2006/time#numericPosition> ;
                                                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                           ]
                                                                         )
                                                           ] ;
                                           rdfs:comment "A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. "@en ,
                                                        "Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales."@es ;
                                           rdfs:label "Time position"@en ,
                                                      "posición de tiempo"@es ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. "@en ,
                                                                                            "Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales."@es .


###  http://www.w3.org/2006/time#TimeZone
<http://www.w3.org/2006/time#TimeZone> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://rds.posccaesar.org/ontology/lis14/rdl/InformationObject> ;
                                       rdfs:comment """A Time Zone specifies the amount by which the local time is offset from UTC. 
	A time zone is usually denoted geographically (e.g. Australian Eastern Daylight Time), with a constant value in a given region. 
The region where it applies and the offset from UTC are specified by a locally recognised governing authority."""@en ,
                                                    """Un huso horario especifica la cantidad en que la hora local está desplazada con respecto a UTC.
        Un huso horario normalmente se denota geográficamente (p.ej. el horario de verano del este de Australia), con un valor constante en una región dada.
        La región donde aplica y el desplazamiento desde UTC las especifica una autoridad gubernamental localmente reconocida."""@es ;
                                       rdfs:label "Time Zone"@en ,
                                                  "huso horario"@es ;
                                       <http://www.w3.org/2004/02/skos/core#definition> """A Time Zone specifies the amount by which the local time is offset from UTC. 
	A time zone is usually denoted geographically (e.g. Australian Eastern Daylight Time), with a constant value in a given region. 
The region where it applies and the offset from UTC are specified by a locally recognised governing authority."""@en ,
                                                                                        """Un huso horario especifica la cantidad en que la hora local está desplazada con respecto a UTC.
    Un huso horario normalmente se denota geográficamente (p.ej. el horario de verano del este de Australia), con un valor constante en una región dada.
    La región donde aplica y el desplazamiento desde UTC las especifica una autoridad gubernamental localmente reconocida."""@es ;
                                       <http://www.w3.org/2004/02/skos/core#historyNote> """En la versión original de OWL-Time de 2006, se definió, en un espacio de nombres diferente \"http://www.w3.org/2006/timezone#\", la clase 'huso horario', con varias propiedades específicas correspondientes a un modelo específico de huso horario.
    En la versión actual hay una clase con el mismo nombre local en el espacio de nombres de OWL-Time, eliminando la dependencia del espacio de nombres externo.
    Un axioma de alineación permite que los datos codificados de acuerdo con la versión anterior sean consistentes con la ontología actualizada."""@es ,
                                                                                         """In the original 2006 version of OWL-Time, the TimeZone class, with several properties corresponding to a specific model of time-zones, was defined in a separate namespace \"http://www.w3.org/2006/timezone#\". 

In the current version a class with same local name is put into the main OWL-Time namespace, removing the dependency on the external namespace. 

An alignment axiom 
	tzont:TimeZone rdfs:subClassOf time:TimeZone . 
allows data encoded according to the previous version to be consistent with the updated ontology. """ ;
                                       <http://www.w3.org/2004/02/skos/core#note> """A designated timezone is associated with a geographic region. However, for a particular region the offset from UTC often varies seasonally, and the dates of the changes may vary from year to year. The timezone designation usually changes for the different seasons (e.g. Australian Eastern Standard Time vs. Australian Eastern Daylight Time). Furthermore, the offset for a timezone may change over longer timescales, though its designation might not.  

Detailed guidance about working with time zones is given in http://www.w3.org/TR/timezone/ ."""@en ,
                                                                                  "An ontology for time zone descriptions was described in [owl-time-20060927] and provided as RDF in a separate namespace tzont:. However, that ontology was incomplete in scope, and the example datasets were selective. Furthermore, since the use of a class from an external ontology as the range of an ObjectProperty in OWL-Time creates a dependency, reference to the time zone class has been replaced with the 'stub' class in the normative part of this version of OWL-Time."@en ,
                                                                                  """Un huso horario designado está asociado con una región geográfica. Sin embargo, para una región particular el desplazamiento desde UTC a menudo varía según las estaciones, y las fechas de los cambios pueden variar de un año a otro. La designación de huso horario  normalmente cambia de una estación a otra (por ejemplo, el horario estándar frente al horario de verano ambos del este de Australia). Además, del desplazamiento para un huso horario puede cambiar sobre escalas de tiempo mayores, aunque su designación no lo haga.
    Se puede encontrar una guía detallada sobre el funcionamiento de husos horarios en http://www.w3.org/TR/timezone/.\"@es , \"En [owl-time-20060927] se describió una ontología para descripciones de husos horarios, y se proporcionó en un espacio de nombres separado tzont:. Sin embargo, dicha ontología estaba incompleta en su alcance, y el ejemplo de conjuntos de datos (datasets) era selectivo. Además, puesto que el uso de una clase de una ontología externa como el rango de una propiedad de objeto en OWL-Time crea una dependencia, la referencia a la clase huso horario se ha reemplazado por una clase que viene a ser un \"cajón de sastre\" en la en la parte normativa de esta versión de OWL-Time."""@es ;
                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "En esta implementación 'huso horario' no tiene definidas propiedades. Se debería pensar como una superclase \"abstracta\" de todas las implementaciones de huso horario específicas."@es ,
                                                                                       "In this implementation TimeZone has no properties defined. It should be thought of as an 'abstract' superclass of all specific timezone implementations." .


###  http://www.w3.org/2006/time#Year
<http://www.w3.org/2006/time#Year> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.w3.org/2006/time#DurationDescription> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/2006/time#days> ;
                                                     owl:cardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/2006/time#hours> ;
                                                     owl:cardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/2006/time#minutes> ;
                                                     owl:cardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/2006/time#months> ;
                                                     owl:cardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/2006/time#seconds> ;
                                                     owl:cardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/2006/time#weeks> ;
                                                     owl:cardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/2006/time#years> ;
                                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   rdfs:comment "Year duration" ;
                                   rdfs:label "Year"@en ;
                                   owl:deprecated "true"^^xsd:boolean ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Year duration" ;
                                   <http://www.w3.org/2004/02/skos/core#historyNote> """Year was proposed in the 2006 version of OWL-Time as an example of how DurationDescription could be specialized to allow for a duration to be restricted to a number of years. 

It is deprecated in this edition of OWL-Time. """ ;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Anno"@it ,
                                                                                   "Année (calendrier)"@fr ,
                                                                                   "Ano"@pt ,
                                                                                   "Año"@es ,
                                                                                   "Jaar"@nl ,
                                                                                   "Jahr"@de ,
                                                                                   "Rok"@pl ,
                                                                                   "Year"@en ,
                                                                                   "Год"@ru ,
                                                                                   "سنة"@ar ,
                                                                                   "年"@ja ,
                                                                                   "年"@zh .


