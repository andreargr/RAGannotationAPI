    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#topDataProperty -->

    <DatatypeProperty rdf:about="http://www.w3.org/2002/07/owl#topDataProperty"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://infohub.siemens-energy.com/cdm#FunctionalObject -->

    <Class rdf:about="http://infohub.siemens-energy.com/cdm#FunctionalObject"/>
    


    <!-- http://infohub.siemens-energy.com/cdm#Object -->

    <Class rdf:about="http://infohub.siemens-energy.com/cdm#Object"/>
    


    <!-- http://infohub.siemens-energy.com/cdm#PhysicalObject -->

    <Class rdf:about="http://infohub.siemens-energy.com/cdm#PhysicalObject"/>
    


    <!-- http://infohub.siemens-energy.com/equipment#Agitator -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#Agitator">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#Mixer"/>
        <rdfs:label>agitator</rdfs:label>
        <skos:definition>An agitator is a mechanical device used to stir, mix, or blend substances, typically liquids or slurries, within a container or vessel.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#CheckValve -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#CheckValve">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Valve"/>
        <rdfs:label>check valve</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#ElectricalActuator -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#ElectricalActuator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/core/Actuator"/>
        <rdfs:label>electrical actuator</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#FlowSightGlass -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#FlowSightGlass">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#SightGlass"/>
        <rdfs:label>flow sight glass</rdfs:label>
        <skos:definition>A flow sight glass is a type of sight glass specifically designed to observe the flow of liquids or gases through a pipeline or vessel.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#GlobeValve -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#GlobeValve">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Valve"/>
        <rdfs:label>globe valve</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#HVACComponent -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#HVACComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Component"/>
        <rdfs:label>HVAC Component</rdfs:label>
        <skos:definition>An HVAC component refers to any individual part or element that contributes to the functionality of a Heating, Ventilation, and Air Conditioning (HVAC) system.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#LevelSightGlass -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#LevelSightGlass">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#SightGlass"/>
        <rdfs:label>level sight glass</rdfs:label>
        <skos:definition>A level sight glass is a specialized sight glass used to monitor the liquid level inside a tank, vessel, or container.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#MechanicalActuator -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#MechanicalActuator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/core/Actuator"/>
        <rdfs:label>mechanical actuator</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#Mixer -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#Mixer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Equipment"/>
        <rdfs:label>mixer</rdfs:label>
        <skos:definition>A mixer is a device or piece of equipment used to blend or combine different substances (such as liquids, powders, pastes, or gases) into a homogeneous mixture.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#MobileHoist -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#MobileHoist">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/ElevatorMachine"/>
        <rdfs:label>mobile hoist</rdfs:label>
        <skos:definition>A mobile hoist is a portable lifting device designed to be moved from one location to another, making it versatile for various tasks.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#Pipe -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#Pipe">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#HVACComponent"/>
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#PipingComponent"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://infohub.siemens-energy.com/props#hasComponent"/>
                <someValuesFrom rdf:resource="http://infohub.siemens-energy.com/equipment#PipeSpool"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:label>pipe</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#PipeSpool -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#PipeSpool">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#HVACComponent"/>
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#PipingComponent"/>
        <rdfs:label>pipe spool</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#Pipeline -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#Pipeline">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#HVACComponent"/>
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#PipingComponent"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="http://infohub.siemens-energy.com/props#hasComponent"/>
                <someValuesFrom rdf:resource="http://infohub.siemens-energy.com/equipment#Pipe"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:label>pipeline</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#PipingComponent -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#PipingComponent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Component"/>
        <rdfs:label>piping component</rdfs:label>
        <skos:definition>A piping component is any individual part or element used in the construction, assembly, operation, or maintenance of a piping system. These components are designed to transport, control, regulate, or manage the flow of fluids (liquids, gases, or slurries) within a system.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#SafetyValve -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#SafetyValve">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Valve"/>
        <rdfs:label>safety valve</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#ShutOffValve -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#ShutOffValve">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Valve"/>
        <rdfs:label>shut off valve</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#SightGlass -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#SightGlass">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#PipingComponent"/>
        <rdfs:label>sight glass</rdfs:label>
        <skos:definition>A sight glass is a transparent viewing port used in industrial equipment such as pipes, tanks, or vessels to allow operators to visually monitor the contents inside the system.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#SolenoidActuator -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#SolenoidActuator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/core/Actuator"/>
        <rdfs:label>solenoid actuator</rdfs:label>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#StaticMixer -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#StaticMixer">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#Mixer"/>
        <CommonCoreOntologies:definition_source>Paul, Edward L. (2004). Handbook of Industrial Mixing-Science and Practice. Hoboken NJ: John Wiley &amp; Sons. pp. 399 section 7-3.1.4.</CommonCoreOntologies:definition_source>
        <rdfs:label>static mixer</rdfs:label>
        <skos:definition>A static mixer is a device for the continuous mixing of fluid materials, without moving components.</skos:definition>
    </Class>
    


    <!-- http://infohub.siemens-energy.com/equipment#StationaryHoist -->

    <Class rdf:about="http://infohub.siemens-energy.com/equipment#StationaryHoist">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/ElevatorMachine"/>
        <rdfs:label>stationary hoist</rdfs:label>
        <skos:definition>A stationary hoist is a fixed lifting device installed in a specific location, such as a warehouse, factory, or construction site.</skos:definition>
    </Class>
    


    <!-- http://purl.org/biotop/btl2.owl#Disposition -->

    <Class rdf:about="http://purl.org/biotop/btl2.owl#Disposition"/>
    


    <!-- http://rds.posccaesar.org/ontology/lis14/rdl/Disposition -->

    <Class rdf:about="http://rds.posccaesar.org/ontology/lis14/rdl/Disposition"/>
    


    <!-- http://rds.posccaesar.org/ontology/lis14/rdl/FunctionalObject -->

    <Class rdf:about="http://rds.posccaesar.org/ontology/lis14/rdl/FunctionalObject"/>
    


    <!-- http://rds.posccaesar.org/ontology/lis14/rdl/Object -->

    <Class rdf:about="http://rds.posccaesar.org/ontology/lis14/rdl/Object"/>
    


    <!-- http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject -->

    <Class rdf:about="http://rds.posccaesar.org/ontology/lis14/rdl/PhysicalObject"/>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/CombustionEngine -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/CombustionEngine">
        <rdfs:subClassOf rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/HeatEngine"/>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Combustion Engine</rdfs:label>
        <skos:definition xml:lang="en">A Heat Engine that is designed to convert thermal energy that is generated through a local Combustion process into mechanical energy.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/ElectricMotor -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/ElectricMotor">
        <rdfs:subClassOf rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Engine"/>
        <CommonCoreOntologies:definition_source rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Electric_motor&amp;oldid=1063829856</CommonCoreOntologies:definition_source>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Electric Motor</rdfs:label>
        <skos:altLabel xml:lang="en">Electric Engine</skos:altLabel>
        <skos:definition xml:lang="en">An Engine that is designed to convert electrical energy into mechanical energy.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/Engine -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/Engine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Equipment"/>
        <CommonCoreOntologies:definition_source rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Engine&amp;oldid=1063879193</CommonCoreOntologies:definition_source>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Engine</rdfs:label>
        <skos:altLabel xml:lang="en">Motor</skos:altLabel>
        <skos:definition xml:lang="en">A Material Artifact that is designed to convert one form of energy into mechanical energy.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/FlowControlValve -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/FlowControlValve">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Valve"/>
        <CommonCoreOntologies:definition_source rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Flow_control_valve&amp;oldid=1013438085</CommonCoreOntologies:definition_source>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:comment xml:lang="en">Flow Control Valves are often more complex than a simple Valve and typically include an Actuator that is capable of automatically adjusting the state of the valve in response to signals from a connected Sensor or Controller.</rdfs:comment>
        <rdfs:label xml:lang="en">Flow Control Valve</rdfs:label>
        <skos:definition xml:lang="en">A Valve that is designed to regulate the flow or Pressure of a fluid.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/HeatEngine -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/HeatEngine">
        <rdfs:subClassOf rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Engine"/>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Heat Engine</rdfs:label>
        <skos:definition xml:lang="en">An Engine that is designed to convert thermal energy into mechanical energy.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/HydraulicMotor -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/HydraulicMotor">
        <rdfs:subClassOf rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/PhysicallyPoweredEngine"/>
        <CommonCoreOntologies:definition_source rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Hydraulic_motor&amp;oldid=1027427666</CommonCoreOntologies:definition_source>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Hydraulic Motor</rdfs:label>
        <skos:definition xml:lang="en">A Physically Powered Engine that converts hydraulic pressure and flow into torque and angular displacement.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/Nozzle -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/Nozzle">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/equipment#PipingComponent"/>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Nozzle</rdfs:label>
        <skos:definition xml:lang="en">A Fluid Control Artifact that is designed to control the speed, direction, rate, shape, or pressure of the flow of fluid exiting it.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/PhysicallyPoweredEngine -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/PhysicallyPoweredEngine">
        <rdfs:subClassOf rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Engine"/>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Physically Powered Engine</rdfs:label>
        <skos:altLabel xml:lang="en">Physical Engine</skos:altLabel>
        <skos:definition xml:lang="en">An Engine that is designed to convert potential or kinetic energy into mechanical energy.</skos:definition>
    </Class>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/PneumaticMotor -->

    <Class rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/PneumaticMotor">
        <rdfs:subClassOf rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/PhysicallyPoweredEngine"/>
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ArtifactOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">Pneumatic Motor</rdfs:label>
        <skos:altLabel xml:lang="en">Air Motor</skos:altLabel>
        <skos:altLabel xml:lang="en">Compressed Air Engine</skos:altLabel>
        <skos:definition xml:lang="en">A Physically Powered Engine that converts potential energy stored in a portion of compressed air into mechanical energy.</skos:definition>
    </Class>
    


    <!-- https://pi.pauwel.be/voc/buildingelement#Tendon -->

    <Class rdf:about="https://pi.pauwel.be/voc/buildingelement#Tendon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec/asset/Component"/>
        <oboInOwl:Synonym>cable</oboInOwl:Synonym>
