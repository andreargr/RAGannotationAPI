    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://infohub.siemens-energy.com/equipment#hasActuator -->

    <ObjectProperty rdf:about="http://infohub.siemens-energy.com/equipment#hasActuator">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label>has actuator</rdfs:label>
    </ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty">
        <rdfs:label xml:lang="iri-based">topObjectProperty</rdfs:label>
    </ObjectProperty>
    


