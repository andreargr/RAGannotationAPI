        <rdfs:domain rdf:resource="https://schema.org/City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>city code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://infohub.siemens-energy.com/Country/regionCode -->

    <owl:DatatypeProperty rdf:about="http://infohub.siemens-energy.com/Country/regionCode">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/rec/core/Region"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>region code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.geonames.org/ontology#countryCode -->

    <owl:DatatypeProperty rdf:about="https://www.geonames.org/ontology#countryCode">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/identifier"/>
        <rdfs:domain rdf:resource="https://schema.org/Country"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>countryCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://www.geonames.org/ontology#geonamesID -->

