    <!-- https://www.geonames.org/ontology#long -->

    <owl:DatatypeProperty rdf:about="https://www.geonames.org/ontology#long"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://schema.org/AdministrativeArea -->

    <owl:Class rdf:about="https://schema.org/AdministrativeArea">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>A geographical region, typically under the jurisdiction of a particular government.</rdfs:comment>
        <rdfs:label>AdministrativeArea</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/City -->

    <owl:Class rdf:about="https://schema.org/City">
        <rdfs:subClassOf rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:comment xml:lang="en">A city or town.</rdfs:comment>
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Country -->

    <owl:Class rdf:about="https://schema.org/Country">
        <rdfs:subClassOf rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:comment>A country.</rdfs:comment>
        <rdfs:label>Country</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Place -->

    <owl:Class rdf:about="https://schema.org/Place">
        <rdfs:comment>Entities that have a somewhat fixed, physical extension.</rdfs:comment>
        <rdfs:label>Place</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/State -->

    <owl:Class rdf:about="https://schema.org/State">
        <rdfs:subClassOf rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:comment xml:lang="en">A state or province of a country.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/State"/>
        <rdfs:label xml:lang="en">State</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rec/core/Region -->

    <owl:Class rdf:about="https://w3id.org/rec/core/Region">
        <rdfs:subClassOf rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:comment>An administrative geospatial unit larger than the individual real estate. For instance, &apos;Lombary&apos;, &apos;North America&apos;, &apos;The Back Bay&apos;, &apos;Elnätsområde Syd&apos;, etc.</rdfs:comment>
        <rdfs:label>region</rdfs:label>
        <skos:definition>An administrative geospatial unit larger than the individual real estate. For instance, &apos;Lombary&apos;, &apos;North America&apos;, &apos;The Back Bay&apos;, &apos;Elnätsområde Syd&apos;, etc.</skos:definition>
    </owl:Class>
    


