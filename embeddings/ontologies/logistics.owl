    </rdf:Description>
    


    <!-- http://www.ontologyrepository.com/CommonCoreOntologies/is_curated_in_ontology -->

    <rdf:Description rdf:about="http://www.ontologyrepository.com/CommonCoreOntologies/is_curated_in_ontology">
        <CommonCoreOntologies:is_curated_in_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ontologyrepository.com/CommonCoreOntologies/Mid/ExtendedRelationOntology</CommonCoreOntologies:is_curated_in_ontology>
        <rdfs:label xml:lang="en">is curated in ontology</rdfs:label>
        <skos:definition xml:lang="en">An annotation property that links a class, property, or named individual to the URI of the ontology where it is located.</skos:definition>
    </rdf:Description>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#isDefinedBy -->

    <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#isDefinedBy">
        <rdfs:comment>The definition of the subject resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2000/01/rdf-schema#"/>
