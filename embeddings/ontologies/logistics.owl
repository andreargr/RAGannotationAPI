    <!-- http://infohub.siemens-energy.com/logistics#BillOfQuantities -->

    <owl:Class rdf:about="http://infohub.siemens-energy.com/logistics#BillOfQuantities">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <rdfs:subClassOf rdf:resource="https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/Contract"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://infohub.siemens-energy.com/organizations#hasContractor"/>
                <owl:allValuesFrom rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A Bill of Quantities (BoQ) is a detailed document used in construction projects that lists out all the materials, parts, and labor needed to complete the work. It breaks down the project into measurable sections and assigns quantities and units to each item.</obo:IAO_0000115>
        <om-2:alternativeLabel>BoQ</om-2:alternativeLabel>
        <rdfs:label>bill of quantities</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/logistics#LogisticData -->

    <owl:Class rdf:about="http://infohub.siemens-energy.com/logistics#LogisticData">
        <rdfs:label>logistic data</rdfs:label>
    </owl:Class>
    


    <!-- http://infohub.siemens-energy.com/logistics#LogisticShipmentData -->

    <owl:Class rdf:about="http://infohub.siemens-energy.com/logistics#LogisticShipmentData">
        <rdfs:subClassOf rdf:resource="http://infohub.siemens-energy.com/logistics#LogisticData"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://infohub.siemens-energy.com/logistics#hasTransportPartner"/>
                <owl:allValuesFrom rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://infohub.siemens-energy.com/logistics#hasTransportType"/>
                <owl:allValuesFrom rdf:resource="http://infohub.siemens-energy.com/logistics#TransportType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://infohub.siemens-energy.com/logistics#hasTransportationFacilityOfEntry"/>
