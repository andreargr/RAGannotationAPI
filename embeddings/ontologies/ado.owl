    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_7514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24870"/>
        <obo:IAO_0000115>A  quaternary ammonium ion comprising an anilinium ion core having three methyl substituents on the aniline nitrogen, and a 3-[(dimethylcarbamoyl)oxy] substituent at position 3. It is a parasympathomimetic which acts as a reversible acetylcholinesterase inhibitor.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
