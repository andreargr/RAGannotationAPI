        <obo:IAO_0000115>Mus musculus (mouse) brain neuroblastoma cell line. Clone Neuro-2a was established by R.J. Klebe and F.H. Ruddle from a spontaneous tumor of a strain A albino mouse.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bto.owl"/>
        <oboInOwl:hasOBONamespace>BrendaTissueOBO</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>N-2a cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>N2A cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>N2a cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>N2alpha cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NB-2a cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NB2a cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NEURO-2A cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nb2a cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Neuro 2A cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Neuro2A cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Neuro2a cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>BTO:0001976</oboInOwl:id>
