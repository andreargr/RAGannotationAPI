        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000459"/>
        <obo:IAO_0000115>Constipation is a feces and droppings symptom involving the abnormally delayed or infrequent passage of dry hardened feces.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/symp.owl"/>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
