    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52206"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_78295"/>
        <obo:IAO_0000115>A biochemical role played by any micronutrient that is an organic compound. Vitamins are present in foods in small amounts and are essential to normal metabolism and biochemical functions, usually as coenzymes. The term &quot;vitamines&quot; (from vita + amines) was coined in 1912 by Casimir Funk, who believed that these compounds were amines.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <oboInOwl:hasAlternativeId>CHEBI:10004</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:27305</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:Vitamin</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>vitamin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamina</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitaminas</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamines</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitamins</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vitaminum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:33229</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/chebi#3_STAR"/>
        <rdfs:label>vitamin (role)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
