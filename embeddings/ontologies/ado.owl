    <!-- http://purl.obolibrary.org/obo/NCIT_C49688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C49688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C70820"/>
        <obo:IAO_0000115>A clinical research protocol generally referred to as a well-controlled and pivotal trial that aims to prove the mechanism of action of the new intervention in question. A pivotal study will generally be well-controlled, randomized, of adequate size, and whenever possible, double-blind.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
