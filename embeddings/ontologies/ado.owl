            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ADO_0000006"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_10652"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A standardized rating scale modified from A. Rey in 1964 and Ceffen et al in 1994, which is used to evaluate verbal learning and memory abilities in both children and adults. The questionnaire contains 36 items and assesses overall memory performance, immediate span of memory for words, acquisition rate, interference effects, and recognition.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C123668</obo:NCIT_NHC0>
