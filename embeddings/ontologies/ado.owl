        <oboInOwl:hasExactSynonym>potassium ion membrane transport</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>high affinity potassium ion import</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>high affinity potassium ion uptake</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>high-affinity potassium ion import</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>high-affinity potassium ion uptake</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0071805</oboInOwl:id>
        <rdfs:comment>Note that this term is not intended for use in annotating lateral movement within membranes.</rdfs:comment>
        <rdfs:label>potassium ion transmembrane transport</rdfs:label>
    </owl:Class>
    


