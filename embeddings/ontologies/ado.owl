    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BTO_0002496 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BTO_0002496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_62493"/>
        <obo:IAO_0000115>A serrated strip of gray matter under the medial border of the hippocampus and in its depths; it is an archaeocortex which develops along the edge of the hippocampal fissure and which consists of molecular, granular, and polymorphic layers.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bto.owl"/>
        <oboInOwl:hasOBONamespace>BrendaTissueOBO</oboInOwl:hasOBONamespace>
