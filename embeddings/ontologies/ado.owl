        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TXPO_0000434"/>
        <obo:IAO_0000115>Dysfunctioning is a subtype of malfunctioning process: A process that performs an abnormal and incomplete functioning.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/txpo.owl"/>
        <rdfs:label>dysfunctioning</rdfs:label>
    </owl:Class>
    


