    <!-- http://purl.obolibrary.org/obo/MONDO_0100087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0100087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10652"/>
        <obo:IAO_0000115>A degenerative disease of the brain that causes gradual loss of memory, judgment, and the ability to function socially. About 25% of all Alzheimer disease is familial (more than 2 people in a family have AD). When Alzheimer disease begins before 60 or 65 years of age (early-onset AD) about 60% of the cases are familial (also known as Early-onset familial AD). These cases appear to be inherited in an autosomal dominant manner.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mondo.owl"/>
        <oboInOwl:created_by>http://orcid.org/0000-0001-5208-3432</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym>Alzheimer disease, familial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>FAD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>GARD:0000632</oboInOwl:hasExactSynonym>
        <oboInOwl:id>MONDO:0100087</oboInOwl:id>
        <rdfs:label>familial Alzheimer disease</rdfs:label>
    </owl:Class>
    


