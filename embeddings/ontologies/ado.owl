        <rdfs:label>Protein Synthesis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C18153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C18153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MI_0501"/>
        <obo:IAO_0000115>Caspases are a family of intracellular cysteine proteinases involved in inflammation and apoptosis.  These enzymes appear to be involved in the initial signaling events, as well as the downstream proteolytic cleavages, that result in apoptotic cell death.  They are specific for aspartic acid at the P1 position and are divided into two classes based on the lengths of their N-terminal pro-domains.  Caspases-1, -2, -4, -5, -8, and -10 have long pro-domains; caspases-3, -6, -7, and -9 have short pro-domains.  (from Science 1998. 281:1312 and Br Med Bull 1997. 53:478)</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C18153</obo:NCIT_NHC0>
        <obo:NCIT_P106>Amino Acid, Peptide, or Protein</obo:NCIT_P106>
        <obo:NCIT_P106>Enzyme</obo:NCIT_P106>
        <obo:NCIT_P107>Caspase</obo:NCIT_P107>
        <obo:NCIT_P108>Caspase</obo:NCIT_P108>
        <obo:NCIT_P207>C0010656</obo:NCIT_P207>
        <obo:NCIT_P322>CTRP</obo:NCIT_P322>
        <obo:NCIT_P366>Caspase</obo:NCIT_P366>
        <oboInOwl:hasExactSynonym>Caspase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Caspases</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cell-Death Protease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cysteine-Dependent Aspartate-Directed Protease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cysteine-aspartic Protease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ICE-like protease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ICE-like proteases</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Peptidase Family C14</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>TNF Alpha ICE Proteinases</oboInOwl:hasExactSynonym>
