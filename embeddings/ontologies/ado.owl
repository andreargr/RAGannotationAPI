        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4895"/>
        <oboInOwl:hasExactSynonym>interaction with another species</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>interspecies interaction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>interspecies interaction between organisms</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>interspecies interaction with other organisms</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
