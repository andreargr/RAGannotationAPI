        <oboInOwl:hasDbXref>ENVO:02000027</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100047</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:9670</oboInOwl:hasDbXref>
