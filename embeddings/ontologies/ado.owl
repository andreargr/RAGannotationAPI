    <!-- http://purl.obolibrary.org/obo/NCIT_C15273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C15273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C15206"/>
        <obo:IAO_0000115>A study in which participants with no known disease are initially assessed, and then reassessed for the same characteristic at mutiple timepoints in the future.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
