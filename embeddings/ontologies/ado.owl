        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/22072636/</obo:IAO_0000119>
        <obo:IAO_0000119>https://pubmed.ncbi.nlm.nih.gov/32286245/</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/opmi.owl"/>
        <rdfs:label xml:lang="en">immune biomarker</rdfs:label>
    </owl:Class>
    


