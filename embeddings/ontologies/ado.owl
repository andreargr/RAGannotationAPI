    <!-- http://purl.obolibrary.org/obo/NCIT_C20391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C20391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
