        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000023"/>
        <obo:IAO_0000115>An endophenotype (also known as intermediate phenotype) is a quantitative biological trait that is reliable in reflecting the function of a discrete biological system and is reasonably heritable, and as such is more closely related to the root cause of the disease than the broad clinical phenotype.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/omit.owl"/>
        <rdfs:label>Endophenotypes</rdfs:label>
    </owl:Class>
    <owl:Axiom>
