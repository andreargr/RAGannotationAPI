    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_8887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33261"/>
        <obo:IAO_0000115>A butenolide that is furan-2(5H)-one substituted by a phenyl group at position 3 and by a p-(methylsulfonyl)phenyl group at position 4. A selective cyclooxygenase 2 inhibitor, it was used from 1999 to 2004 for the treatment of ostoarthritis, but was withdrawn following concerns about an associated increased risk of heart attack and stroke.</obo:IAO_0000115>
