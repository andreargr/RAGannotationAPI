        <obo:NCIT_P207>C0027775</obo:NCIT_P207>
        <obo:NCIT_P366>Nested_Case-control_Study</obo:NCIT_P366>
        <oboInOwl:hasExactSynonym>Nested Case-control Study</oboInOwl:hasExactSynonym>
        <rdfs:label>Nested Case-control Study</rdfs:label>
    </owl:Class>
    


