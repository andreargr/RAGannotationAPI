        <rdfs:label>medium spiny neuron</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_2000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_2000029">
