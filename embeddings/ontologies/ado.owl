        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <rdfs:label>CNS neuron (sensu Vertebrata)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000118">
