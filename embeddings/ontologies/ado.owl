        <oboInOwl:hasExactSynonym>APP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>APPI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CVAP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PN-II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PreA4</oboInOwl:hasExactSynonym>
