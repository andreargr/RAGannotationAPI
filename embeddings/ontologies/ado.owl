        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100087"/>
        <obo:IAO_0000115>A form of familial Alzheimer disease, that begins after age 65.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mondo.owl"/>
        <oboInOwl:hasDbXref>GARD:0012799</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Alzheimer disease type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:id>MONDO:0100088</oboInOwl:id>
        <rdfs:label>late-onset familial alzheimer disease</rdfs:label>
    </owl:Class>
    


