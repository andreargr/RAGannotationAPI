        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <rdfs:label>ependymal cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000094">
