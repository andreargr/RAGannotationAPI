            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The principle of functional MRI imaging is to take a series of images of an organ in quick succession and to statistically analyze the images for differences among them.  Most commonly used in studies of brain function.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C17958</obo:NCIT_NHC0>
        <obo:NCIT_P106>Diagnostic Procedure</obo:NCIT_P106>
        <obo:NCIT_P107>Functional Magnetic Resonance Imaging</obo:NCIT_P107>
        <obo:NCIT_P108>Functional Magnetic Resonance Imaging</obo:NCIT_P108>
