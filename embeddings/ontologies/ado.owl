    <!-- http://purl.obolibrary.org/obo/NCIT_C49686 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C49686">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C70820"/>
        <obo:IAO_0000115>A clinical research protocol generally referred to as a pilot or feasibility trial that aims to prove the concept of the new intervention in question.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
