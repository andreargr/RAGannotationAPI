    <!-- http://purl.obolibrary.org/obo/SYMP_0000734 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000734">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000480"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ADO_0000004"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_10652"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stroke is a nervous system symptom characterized by a sudden diminution or loss of consciousness, sensation, and voluntary motion caused by rupture or obstruction (as by a clot) of a blood vessel of the brain.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/symp.owl"/>
        <oboInOwl:hasExactSynonym>apoplexy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>brain attack</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebral accident</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebrovascular accident</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000734</oboInOwl:id>
        <rdfs:label>stroke</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0019180 -->

