    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GO_0044848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0044848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
        <obo:IAO_0000115>A distinct period or stage in a biological process or cycle.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/go.owl"/>
        <oboInOwl:created_by>jl</oboInOwl:created_by>
        <oboInOwl:creation_date>2014-07-16T13:12:40Z</oboInOwl:creation_date>
