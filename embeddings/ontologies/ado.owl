        <obo:IAO_0000115>Neuroglial cells of ectodermal origin, i.e., the astrocytes and oligodendrocytes considered together. Originally, the term was used for the astrocytes alone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bto.owl"/>
        <oboInOwl:hasOBONamespace>BrendaTissueOBO</oboInOwl:hasOBONamespace>
