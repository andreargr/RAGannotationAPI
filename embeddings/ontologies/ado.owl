        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MI_0501"/>
        <obo:IAO_0000115>Catalysis role of the phosphorylation of an amino acid residue in a protein, usually according to the reaction: a protein + ATP = a phosphoprotein + ADP.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/txpo.owl"/>
