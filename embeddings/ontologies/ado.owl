        <oboInOwl:hasExactSynonym>NSC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neural stem cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <rdfs:label>neuronal stem cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000065">
