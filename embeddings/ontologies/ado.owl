        <oboInOwl:hasNarrowSynonym>WNT-FZD-LRP5 complex</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>WNT-FZD-LRP6 complex</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
