        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:67304</oboInOwl:id>
        <rdfs:label>Cell appendage</rdfs:label>
    </owl:Class>
    


