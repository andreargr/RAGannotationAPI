    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000117"/>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <oboInOwl:hasDbXref>BTO:0003393</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
