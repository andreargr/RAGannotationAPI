        <oboInOwl:hasAlternativeId>GO:0023046</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0044700</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>biological signaling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>signaling process</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>signalling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>signalling process</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>single organism signaling</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0023052</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_agr"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_flybase_ribbon"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_mouse"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_pombe"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#goslim_yeast"/>
        <rdfs:comment>Note that a signal is any variable property or parameter that serves to convey information, and may be a physical entity such as a gene product or small molecule, a photon, or a change in state such as movement or voltage change.</rdfs:comment>
        <rdfs:label>signaling</rdfs:label>
    </owl:Class>
    


