        <oboInOwl:hasAlternativeId>GO:0015457</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0015460</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>GO:0044765</oboInOwl:hasAlternativeId>
        <oboInOwl:hasNarrowSynonym>small molecule transport</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>solute:solute exchange</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>single-organism transport</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0006810</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/go#gocheck_do_not_annotate"/>
