        <obo:IAO_0000115>The organic response of tissues to external insult, injury or underlying genetic or epigenetic lesion.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mpath.owl"/>
        <oboInOwl:hasOBONamespace>mouse_pathology.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MPATH:596</oboInOwl:id>
        <rdfs:label>pathological process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0000921 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0000921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012638"/>
        <obo:IAO_0000115>a partial absence or patchy, incomplete area of a myelin sheath over all or part of an axon or fiber tract due to degeneration or destruction of the myelin sheath</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mp.owl"/>
        <oboInOwl:hasAlternativeId>MP:0010049</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>myelin degeneration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myelin destruction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>MPheno.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MP:0000921</oboInOwl:id>
        <rdfs:comment>Demyelination is a term used to describe the destruction of the myelin sheath that surrounds axonal fibres. This is caused by diseases that damage the myelin sheath or the cells that form it.</rdfs:comment>
        <rdfs:label>demyelination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0001864 -->

