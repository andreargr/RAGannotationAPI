    <!-- http://purl.obolibrary.org/obo/NCIT_C53360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C53360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBCS_0000231"/>
        <obo:IAO_0000115>The death rate, or proportion of a given population that dies, during a specified time period, statistically modified to eliminate the effect of the various age distributions.</obo:IAO_0000115>
