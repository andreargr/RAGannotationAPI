    <!-- http://purl.obolibrary.org/obo/NCIT_C17958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C17958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C19609"/>
