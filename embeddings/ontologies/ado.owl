    <!-- http://purl.obolibrary.org/obo/NCIT_C16631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C16631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000115>The genetic constitution of an organism or cell, as distinct from its expressed features or phenotype.</obo:IAO_0000115>
