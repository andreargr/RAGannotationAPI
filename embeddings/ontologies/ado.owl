        <obo:IAO_0000119>http://www.ncbi.nlm.nih.gov/pubmed/11072960</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/oae.owl"/>
        <obo:OAE_0004334>10061623</obo:OAE_0004334>
        <rdfs:label>adverse drug effect</rdfs:label>
    </owl:Class>
    


