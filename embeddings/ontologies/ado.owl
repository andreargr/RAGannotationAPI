    <!-- http://purl.obolibrary.org/obo/PR_000018264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PR_000018264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PR_000000001"/>
        <obo:IAO_0000115>A protein that is produced as the result of proteolytic processing of a longer protein.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
        <oboInOwl:hasExactSynonym>ClvPrd</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>peptide</oboInOwl:hasNarrowSynonym>
