    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0019182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0019182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000480"/>
        <obo:IAO_0000115>A nervous system symptom that involves, is related to, or emphasizes behavior.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/symp.owl"/>
        <rdfs:label xml:lang="en">behavioral symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TXPO_0000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TXPO_0000145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TXPO_0000271"/>
        <obo:IAO_0000115>Function-related process is a process that related to the execution of a function, a metafunction, and the malfunction.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/txpo.owl"/>
        <oboInOwl:hasDbXref>FBRL: A Function and Behavior Representation Language. Sasajima, M., Kitamura, Y., Ikeda, M. &amp; Mizoguchi, R., In Proc. of IJCAI-95 (pp. 1830-1836), 1995</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>doi:10.1115/DETC2006-9913</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://doi.org/10.1016/S1474-0346(02)00006-X</oboInOwl:hasDbXref>
        <rdfs:comment>This tree is based on a functional concept ontology (Kitamura 2002).</rdfs:comment>
        <rdfs:label>function-related process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TXPO_0000271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TXPO_0000271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>Primitive process is a unit of process.
Process series at a certain granular level can appear as one primitive process at the higher level.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/txpo.owl"/>
        <rdfs:comment>Whether the process is a primitive process or not depends on the setting of the granularity.
When one does not consider the details more than a certain level, or a level as the minimum grain size, the process at that level becomes the primitive process.</rdfs:comment>
        <rdfs:label>primitive process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TXPO_0000328 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TXPO_0000328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TXPO_0003638"/>
        <obo:IAO_0000115>A role played by the entity which enables the facilitated diffusion of an ion (by an energy-independent process) by passage through a transmembrane aqueous pore or channel without evidence for a carrier-mediated mechanism. May be either selective (it enables passage of a specific ion only) or non-selective (it enables passage of two or more ions of same charge but different size).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/txpo.owl"/>
        <rdfs:comment>related molecular function GO:0005216</rdfs:comment>
        <rdfs:label>ion channel</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TXPO_0000378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TXPO_0000378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TXPO_0000145"/>
        <obo:IAO_0000115>Functioning process is a subtype of function-related process: A process that executes and manifests function.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/txpo.owl"/>
        <rdfs:label>functioning process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TXPO_0000434 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TXPO_0000434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TXPO_0000145"/>
        <obo:IAO_0000115>Malfunctioning process is a subtype of function-related process: A process that cannot perform a function appropriately or cannot realize it at all.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/txpo.owl"/>
        <rdfs:label>malfunctioning process</rdfs:label>
