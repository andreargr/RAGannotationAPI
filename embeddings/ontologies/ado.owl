    <!-- http://purl.obolibrary.org/obo/UBERON_0002308 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000125"/>
        <obo:IAO_0000115>A neural nucleus that is part of the brain.</obo:IAO_0000115>
