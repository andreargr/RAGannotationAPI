    <!-- http://purl.obolibrary.org/obo/CHEBI_39026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_39026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36080"/>
        <obo:IAO_0000115>A class of lipoproteins of small size (18-25 nm) and low density (1.019-1.063 g/ml) particles with a core composed mainly of cholesterol esters and smaller amounts of triglycerides. The surface monolayer consists mostly of phospholipids, a single copy of apolipoprotein B-100, and free cholesterol molecules. The main function of LDL is to transport cholesterol and cholesterol esters from the liver. Excessive levels are associated with cardiovascular disease.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <oboInOwl:hasDbXref>PMID:11082530</oboInOwl:hasDbXref>
