        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <rdfs:label>hippocampal neuron</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_1001474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1001474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000029"/>
        <obo:IAO_0000115>The inhibitory projection neurons located in the striatum that integrate glutamatergic signals arising from the cerebral cortex and thalamus.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <oboInOwl:hasDbXref>BTO:0004778</oboInOwl:hasDbXref>
