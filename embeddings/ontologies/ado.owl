    <!-- http://purl.obolibrary.org/obo/CHEBI_16796 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_16796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35352"/>
        <obo:IAO_0000115>A member of the class of  acetamides that is acetamide in which one of the hydrogens attached to the nitrogen atom is replaced by a 2-(5-methoxy-1H-indol-3-yl)ethyl group. It is a hormone secreted by the pineal gland in humans.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
