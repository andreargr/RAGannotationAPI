        <oboInOwl:hasAlternativeId>CHEBI:23074</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:7242</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>KEGG:C00195</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>LIPID_MAPS_class:LMSP02</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:7542630</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ceramide</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Ceramide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Cer</oboInOwl:hasRelatedSynonym>
