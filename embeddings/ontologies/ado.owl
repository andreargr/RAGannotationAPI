    <!-- http://purl.obolibrary.org/obo/UBERON_0001926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_62007"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002020"/>
        <obo:IAO_0000115>the group of neurons that serve as the primary processor of visual information received from the retina via the optic tract and send processed information to the visual cortex of the occipital lobe</obo:IAO_0000115>
