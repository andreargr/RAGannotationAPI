    <!-- http://purl.obolibrary.org/obo/FOODON_00002452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000112 xml:lang="en">Familiar examples of invertebrates include arthropods (insects, arachnids, crustaceans, and myriapods), mollusks (chitons, snails, bivalves, squids, and octopuses), annelids (earthworms and leeches), and cnidarians (hydras, jellyfishes, sea anemones, and corals).[wikipedia]</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">Invertebrates are animals that neither possess nor develop a vertebral column (commonly known as a backbone or spine), derived from the notochord. This includes all animals apart from the subphylum Vertebrata.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Damion Dooley</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Invertebrate</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/foodon.owl"/>
        <oboInOwl:hasBroadSynonym xml:lang="en">animal</oboInOwl:hasBroadSynonym>
        <rdfs:label xml:lang="en">invertebrate animal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FYPO_0000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FYPO_0000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0005622"/>
        <obo:IAO_0000115>A cell phenotype in which DNA is broken into small fragments.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/fypo.owl"/>
        <oboInOwl:created_by>midori</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-04-19T02:59:38Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>DNA fragmentation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fission_yeast_phenotype</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>fragmented nucleus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FYPO:0000160</oboInOwl:id>
        <rdfs:comment>Use &apos;fragmented DNA&apos; (FYPO:0000160) or one of its descendants if DNA was detected using a method that can resolve molecule sizes (e.g. gel electrophoresis) or detect DNA ends (e.g. TUNEL assay). Otherwise, consider using &apos;fragmented nucleus&apos; (FYPO:0001919) or one of its descendants.</rdfs:comment>
        <rdfs:label>fragmented DNA</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GECKO_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GECKO_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:GECKO_9000000>socio-demographic and economic characteristics</obo:GECKO_9000000>
        <obo:GECKO_9000001>gender</obo:GECKO_9000001>
        <obo:IAO_0000115>An organismal quality inhering in a bearer by virtue of the bearer&apos;s preference towards a range of characteristics pertaining to, and differentiating between, masculinity and femininity.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia:Gender|PATO:0000047</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/gecko.owl"/>
        <rdfs:label>gender</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GECKO_0000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GECKO_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <obo:GECKO_9000000>cognitive and psychological measurements</obo:GECKO_9000000>
        <obo:GECKO_9000001>cognitive functioning</obo:GECKO_9000001>
        <obo:IAO_0000115>A psychological measurement of some aspect of intellectual functions such as memory, problem solving, and comprehension.</obo:IAO_0000115>
        <obo:IAO_0000119>Wikipedia:Cognition</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/gecko.owl"/>
        <rdfs:label>cognitive measurement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/GECKO_0000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GECKO_0000134">
