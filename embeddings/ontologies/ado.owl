        <oboInOwl:hasDbXref>EFO:0000913</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EV:0100167</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:61824</oboInOwl:hasDbXref>
