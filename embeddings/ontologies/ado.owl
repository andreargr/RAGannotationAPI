    <!-- http://purl.obolibrary.org/obo/CHEBI_5004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_5004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33582"/>
        <obo:IAO_0000115>A monocarboxylic acid that is propanoic acid in which one of the hydrogens at position 2 is substituted by a 3-phenoxyphenyl group. A non-steroidal anti-inflammatory drug, the dihydrate form of the calcium salt is used for the management of mild to moderate pain and for the relief of pain and inflammation associated with  disorders such as arthritis. It is pharmacologically similar to aspirin, but causes less gastrointestinal bleeding.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <chebi:charge>0</chebi:charge>
        <chebi:formula>C15H14O3</chebi:formula>
        <chebi:inchi>InChI=1S/C15H14O3/c1-11(15(16)17)12-6-5-9-14(10-12)18-13-7-3-2-4-8-13/h2-11H,1H3,(H,16,17)</chebi:inchi>
