    <!-- http://purl.obolibrary.org/obo/UBERON_0003027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010314"/>
        <obo:IAO_0000115>The cingulate cortex is a part of the brain situated in the medial aspect of the cortex. It is extended from the corpus callosum below to the cingulate sulcus above, at least anteriorly. [WP,unvetted].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <oboInOwl:hasDbXref rdf:resource="http://en.wikipedia.org/wiki/Cingulate_cortex"/>
