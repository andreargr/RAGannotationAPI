    <!-- http://purl.obolibrary.org/obo/NCIT_C117997 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C117997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C20993"/>
        <obo:IAO_0000115>A standardized rating scale originally developed by Chouinard et al in 1980, which is used to measure drug-induced extrapyramidal symptoms (EPS) or 4 types of drug-induced movement disorders (DIMD): parkinsonism, akathisia, dystonia, and tardive dyskinesia. The questionnaire contains 28 questions and generates 4 subscales and 4 clinical global impression severity (CGI-S) scales.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C117997</obo:NCIT_NHC0>
        <obo:NCIT_P106>Intellectual Product</obo:NCIT_P106>
        <obo:NCIT_P108>Extrapyramidal Symptom Rating Scale-Abbreviated Clinical Classification</obo:NCIT_P108>
        <obo:NCIT_P207>C3896675</obo:NCIT_P207>
        <obo:NCIT_P322>CDISC</obo:NCIT_P322>
        <obo:NCIT_P325>Extrapyramidal Symptom Rating Scale-Abbreviated (ESRS-A) (Copyright 2006 Larry Alphs, MD, PhD, Guy Chouinard, MD, All Rights Reserved).</obo:NCIT_P325>
        <oboInOwl:hasExactSynonym>ESRS-A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ESRSA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ESRSA1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Extrapyramidal Symptom Rating Scale-Abbreviated Clinical Classification</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/NCIT_C118970"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/NCIT_C118971"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/NCIT_C120166"/>
