        <obo:IAO_0000115>An epithelium characterised by its most superficial layer consisting of squamous epithelial cells.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
