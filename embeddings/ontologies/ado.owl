    <!-- http://purl.obolibrary.org/obo/NCIT_P108 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/NCIT_P108">
        <obo:IAO_0000115>A property representing the word or phrase that NCI uses by preference to refer to the concept.</obo:IAO_0000115>
        <obo:IAO_0000115>The word or phrase that NCI uses by preference to refer to the concept.</obo:IAO_0000115>
