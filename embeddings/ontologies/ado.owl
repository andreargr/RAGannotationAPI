    <!-- http://purl.obolibrary.org/obo/CHEBI_7936 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_7936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35469"/>
        <obo:IAO_0000115>A benzodioxole that consists of piperidine bearing 1,3-benzodioxol-5-yloxy)methyl and 4-fluorophenyl substituents at positions 3 and 4 respectively; the (3S,4R)-diastereomer. Highly potent and selective 5-HT uptake inhibitor that binds with high affinity to the serotonin transporter (Ki = 0.05 nM). Ki values are 1.1, 350 and 1100 nM for inhibition of [3H]-5-HT, [3H]-l-NA and [3H]-DA uptake respectively. Displays minimal affinity for alpha1-, alpha2- or beta-adrenoceptors, 5-HT2A, 5-HT1A, D2 or H1 receptors at concentrations below 1000 nM, however displays weak affinity for muscarinic ACh receptors (Ki = 42 nM). Antidepressant and anxiolytic in vivo.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <chebi:charge>0</chebi:charge>
        <chebi:formula>C19H20FNO3</chebi:formula>
        <chebi:inchi>InChI=1S/C19H20FNO3/c20-15-3-1-13(2-4-15)17-7-8-21-10-14(17)11-22-16-5-6-18-19(9-16)24-12-23-18/h1-6,9,14,17,21H,7-8,10-12H2/t14-,17-/m0/s1</chebi:inchi>
        <chebi:inchikey>AHOUBRCZNHFOSL-YOEHRIQHSA-N</chebi:inchikey>
        <chebi:mass>329.36540</chebi:mass>
        <chebi:monoisotopicmass>329.14272</chebi:monoisotopicmass>
        <chebi:smiles>[H][C@]1(CCNC[C@H]1COc1ccc2OCOc2c1)c1ccc(F)cc1</chebi:smiles>
