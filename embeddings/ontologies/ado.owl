        <oboInOwl:hasDbXref>BAMS:HiF</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:715</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BM:Tel-HF</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0000601</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DHBA:10294</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35405</oboInOwl:hasDbXref>
