        <oboInOwl:hasOBONamespace>fma</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FMA:67135</oboInOwl:id>
        <rdfs:label>Anatomical structure</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
    </owl:Class>
    


