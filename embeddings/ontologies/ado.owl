    <!-- http://purl.obolibrary.org/obo/NCIT_C15327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C15327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000659"/>
        <obo:IAO_0000115>An invasive procedure in which a hollow needle is introduced through an intervertebral space in the lower back to access the subarachnoid space in order to sample cerebrospinal fluid or to administer medication.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C15327</obo:NCIT_NHC0>
