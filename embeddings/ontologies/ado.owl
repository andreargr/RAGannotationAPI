        <oboInOwl:hasRelatedSynonym>hetarenes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:33833</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/chebi#3_STAR"/>
        <rdfs:label>heteroarene</rdfs:label>
    </owl:Class>
    


