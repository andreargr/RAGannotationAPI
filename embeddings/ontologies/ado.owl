        <obo:IAO_0000115>A protein that is a translation product of the human APP gene or a 1:1 ortholog thereof.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/pr.owl"/>
        <oboInOwl:hasExactSynonym>ABPP</oboInOwl:hasExactSynonym>
