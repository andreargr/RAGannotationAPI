        <oboInOwl:hasRelatedSynonym>hippocampal dentate gyrus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>BTO:0002496</oboInOwl:id>
        <rdfs:label>dentate gyrus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BTO_0002774 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BTO_0002774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012639"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ADO_0000007"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_10652"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A plaque consisting of tangles of amyloid protein in nervous tissue (a pathological mark of Alzheimer&apos;s disease).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bto.owl"/>
        <oboInOwl:hasOBONamespace>BrendaTissueOBO</oboInOwl:hasOBONamespace>
        <oboInOwl:id>BTO:0002774</oboInOwl:id>
        <rdfs:label>amyloid plaque</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BTO_0004477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BTO_0004477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000956"/>
        <obo:IAO_0000115>The medial temporal lobes are near the Sagittal plane that divides left and right cerebral hemispheres and are thought to be involved in episodic, declarative memory.</obo:IAO_0000115>
