    <!-- http://purl.obolibrary.org/obo/NCIT_C86983 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C86983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C117960"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ADO_0000006"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_10652"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Criteria for the diagnosis of Alzheimer&apos;s disease (AD), proposed in 1984 by the National Institute of Neurological and Communicative Disorders (NINCDS) and the Stroke-Alzheimer&apos;s Disease and Related Disorders Association (ADRDA, now the Alzheimer&apos;s Association). The criteria state that existing cognitive impairment may be considered possible or probable AD by neuropsychological testing but definitive diagnosis requires histopathologic confirmation. They specify eight cognitive domains that may be impaired in AD: memory, language, perceptual skills, attention, constructive abilities, orientation, problem solving, and functional abilities.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <obo:NCIT_NHC0>C86983</obo:NCIT_NHC0>
        <obo:NCIT_P106>Idea or Concept</obo:NCIT_P106>
        <obo:NCIT_P108>NINCDS-ADRDA Criteria for Alzheimer&apos;s Disease</obo:NCIT_P108>
        <obo:NCIT_P207>C2828081</obo:NCIT_P207>
        <oboInOwl:hasExactSynonym>NINCDS-ADRDA Criteria for Alzheimer&apos;s Disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>National Institute of Neurological and Communicative Disorders and Stroke and Alzheimer&apos;s Disease and Related Disorders Association Criteria for Alzheimer&apos;s Disease</oboInOwl:hasExactSynonym>
        <rdfs:label>NINCDS-ADRDA Criteria for Alzheimer&apos;s Disease</rdfs:label>
    </owl:Class>
    


