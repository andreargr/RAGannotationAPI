        <oboInOwl:hasDbXref>CALOHA:TS-0898</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>cell</oboInOwl:hasOBONamespace>
        <rdfs:label>Schwann cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CL_0002608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002608">
