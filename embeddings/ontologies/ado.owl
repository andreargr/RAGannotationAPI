        <oboInOwl:hasDbXref>TAO:0002184</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0007806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001626</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CSF</oboInOwl:hasExactSynonym>
