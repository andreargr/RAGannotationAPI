    <!-- http://purl.obolibrary.org/obo/CHEBI_35474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35470"/>
        <obo:IAO_0000115>Anxiolytic drugs are agents that alleviate anxiety, tension, and anxiety disorders, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
