        <oboInOwl:hasOBONamespace>influencing_factor</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>alcohol drinking</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>alcohol use</oboInOwl:hasRelatedSynonym>
