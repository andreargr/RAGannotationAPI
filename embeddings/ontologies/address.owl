    <!-- https://schema.org/addressCountry -->

    <owl:ObjectProperty rdf:about="https://schema.org/addressCountry">
        <rdfs:domain rdf:resource="https://schema.org/PostalAddress"/>
        <rdfs:range rdf:resource="https://schema.org/Country"/>
        <rdfs:comment xml:lang="en">The country. Recommended to be in 2-letter &lt;a href=&quot;http://en.wikipedia.org/wiki/ISO_3166-1&quot;&gt;ISO 3166-1 alpha-2&lt;/a&gt; format, for example &quot;US&quot;. For backward compatibility, a 3-letter &lt;a href=&quot;https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3&quot;&gt;ISO 3166-1 alpha-3&lt;/a&gt; country code such as &quot;SGP&quot; or a full country name such as &quot;Singapore&quot; can also be used.</rdfs:comment>
        <rdfs:comment>The country. Recommended to be in 2-letter [ISO 3166-1 alpha-2](http://en.wikipedia.org/wiki/ISO_3166-1) format, for example &quot;US&quot;. For backward compatibility, a 3-letter [ISO 3166-1 alpha-3](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3) country code such as &quot;SGP&quot; or a full country name such as &quot;Singapore&quot; can also be used.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/addressCountry"/>
        <rdfs:label>addressCountry</rdfs:label>
        <rdfs:label xml:lang="en">addressCountry</rdfs:label>
    </owl:ObjectProperty>
    


