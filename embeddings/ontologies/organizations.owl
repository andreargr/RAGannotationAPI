     xmlns:vcard="http://www.w3.org/2006/vcard/ns#"
     xmlns:owlTime="http://www.w3.org/2006/time#">
    <owl:Ontology rdf:about="http://infohub.siemens-energy.com/organizations">
        <owl:imports rdf:resource="http://infohub.siemens-energy.com/top-props"/>
        <dct:title>Organizations ontology</dct:title>
        <rdfs:comment>Based on the core organization ontology (http://www.w3.org/ns/org)</rdfs:comment>
        <rdfs:label>Organizations ontology</rdfs:label>
    </owl:Ontology>
    


